---
/**
 * Newsletter / interest-list signup, styled as part of the site.
 *
 * The newsletter form submits to the Mailchimp embedded form in
 * site.config.ts in the background and shows Mailchimp's reply under the
 * button; without JavaScript it posts to Mailchimp in a new tab. The
 * interest-list form (withInterests), and the newsletter form while no
 * Mailchimp form is set, open a pre-filled email instead: the Mailchimp form
 * has no field for program areas.
 */
import { site, areas } from '../site.config';

interface Props {
  id: string;
  /** Ask which program areas the person is interested in. */
  withInterests?: boolean;
  submitLabel?: string;
  tone?: 'light' | 'dark';
}
const { id, withInterests = false, submitLabel = 'Sign Up', tone = 'light' } = Astro.props;
const action = withInterests ? null : site.mailingListAction;
// Mailchimp's anti-spam field, named after the account and audience ids in
// the form's URL. People never see it; bots that fill it in are ignored.
const params = action ? new URL(action).searchParams : undefined;
const honeypot = params && `b_${params.get('u')}_${params.get('id')}`;
---

<form
  class="grid gap-4"
  method="post"
  action={action ?? `mailto:${site.email}`}
  target={action ? '_blank' : undefined}
  data-mailing-list
  data-mailchimp={action ? '' : undefined}
  data-fallback-email={action ? undefined : site.email}
>
  {
    withInterests && (
      <fieldset>
        <legend class="text-[15px] font-medium text-ink">I’d like to hear about</legend>
        <div class="mt-2 grid gap-2 sm:grid-cols-3">
          {Object.entries(areas).filter(([, area]) => area.href).map(([key, area]) => (
            <label class="flex min-h-11 items-center gap-2 rounded-lg border border-border-strong bg-canvas px-3 text-[15px] text-ink has-checked:border-raspberry">
              <input type="checkbox" name="INTERESTS" value={area.label} class="size-4 accent-raspberry" checked={key !== 'hikam-foundations'} />
              {area.label}
            </label>
          ))}
        </div>
      </fieldset>
    )
  }
  <div class="flex w-full">
    <label for={`${id}-email`} class="sr-only">Email address</label>
    <input
      id={`${id}-email`}
      type="email"
      name="EMAIL"
      required
      autocomplete="email"
      placeholder="Email address"
      class:list={[
        'min-h-[52px] w-full min-w-0 rounded-l-[10px] border border-r-0 px-5 text-base text-ink placeholder:text-ink-soft focus:outline-none',
        tone === 'dark' ? 'border-transparent bg-surface focus:border-gold' : 'border-border-strong bg-surface focus:border-raspberry',
      ]}
    />
    <button
      type="submit"
      class:list={[
        'min-h-[52px] shrink-0 rounded-r-[10px] px-5 text-[15px] font-medium transition-colors disabled:cursor-wait disabled:opacity-80',
        tone === 'dark'
          ? 'border border-gold bg-transparent text-on-raspberry hover:bg-on-raspberry hover:text-raspberry'
          : 'bg-raspberry text-on-raspberry hover:bg-raspberry-deep',
      ]}
    >
      {submitLabel}
    </button>
  </div>
  {
    honeypot && (
      <div aria-hidden="true" class="absolute -left-[5000px]">
        <input type="text" name={honeypot} tabindex="-1" value="" autocomplete="off" />
      </div>
    )
  }
  {
    action && (
      <p
        role="status"
        data-reply
        hidden
        class:list={['text-[15px] leading-relaxed', tone === 'dark' ? 'text-on-raspberry' : 'text-ink']}
      />
    )
  }
</form>

<script>
  // Without a mailing-list endpoint, signing up opens a pre-filled email.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-mailing-list][data-fallback-email]')) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const interests = data.getAll('INTERESTS').map(String);
      const lines = [`Please add ${data.get('EMAIL')} to the Sabeel Institute mailing list.`];
      if (interests.length) lines.push(`Interested in: ${interests.join(', ')}.`);
      const subject = encodeURIComponent(interests.length ? 'Program interest list' : 'Newsletter subscription');
      window.location.href = `mailto:${form.dataset.fallbackEmail}?subject=${subject}&body=${encodeURIComponent(lines.join('\n'))}`;
    });
  }

  // Mailchimp's JSONP endpoint (post-json) answers with a script, which lets a
  // static site show the reply without leaving the page.
  type Reply = { result: 'success' | 'error'; msg: string };
  const callbacks = window as unknown as Record<string, ((reply: Reply) => void) | undefined>;

  function subscribe(form: HTMLFormElement): Promise<Reply> {
    return new Promise((resolve, reject) => {
      const callback = `mailchimpReply${Date.now()}`;
      const url = new URL(form.action.replace('/subscribe/post?', '/subscribe/post-json?'));
      for (const [key, value] of new FormData(form)) url.searchParams.append(key, String(value));
      url.searchParams.set('c', callback);
      const script = document.createElement('script');
      const cleanup = () => {
        clearTimeout(timer);
        delete callbacks[callback];
        script.remove();
      };
      const timer = setTimeout(() => {
        cleanup();
        reject(new Error('timeout'));
      }, 15000);
      callbacks[callback] = (reply) => {
        cleanup();
        resolve(reply);
      };
      script.onerror = () => {
        cleanup();
        reject(new Error('network'));
      };
      script.src = url.href;
      document.head.append(script);
    });
  }

  // Mailchimp's messages can carry HTML and a field number ("0 - ...").
  function wording(reply: Reply): string {
    const text = reply.msg.replace(/<[^>]*>/g, '').replace(/^\d+ - /, '').trim();
    if (reply.result === 'success') return text;
    if (/already subscribed/i.test(text)) return 'You’re already subscribed. Thank you!';
    if (/too many/i.test(text)) return 'Too many sign-up attempts for this address. Please try again in a few minutes.';
    return text;
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-mailchimp]')) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const reply = form.querySelector<HTMLElement>('[data-reply]')!;
    const label = button.textContent;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      button.textContent = 'Sending…';
      try {
        const answer = await subscribe(form);
        reply.textContent = wording(answer);
        if (answer.result === 'success') form.reset();
      } catch {
        reply.textContent = 'Sorry, that didn’t go through. Please try again in a moment.';
      }
      reply.hidden = false;
      button.disabled = false;
      button.textContent = label;
    });
  }
</script>
