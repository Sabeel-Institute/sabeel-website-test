---
/** Three photo slots side by side, the same size, with captions, e.g. women · teens · children. */
import Photo from './Photo.astro';
import type { IconName } from './Icon.astro';

interface Props {
  tiles: { slot: string; label: string; alt: string; icon: IconName }[];
}
const { tiles } = Astro.props;
---

<div class="grid grid-cols-3 gap-3 sm:gap-4">
  {
    tiles.map((t) => (
      <figure class="relative">
        <Photo
          slot={t.slot}
          alt={t.alt}
          icon={t.icon}
          class="aspect-[3/4] shadow-card"
          compact
          sizes="(min-width: 768px) 16vw, 33vw"
          eager
        />
        <figcaption class="absolute bottom-2 left-2 rounded-full bg-surface/95 px-3 py-1 text-[13px] font-semibold text-ink shadow-card">
          {t.label}
        </figcaption>
      </figure>
    ))
  }
</div>
