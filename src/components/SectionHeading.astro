---
/**
 * A chapter opening: a gilt rule across the page, then the chapter numeral,
 * the running label, and the title; the default slot is aside text on the
 * right. Without a numeral, a rosette takes its place.
 */
import Rosette from './illumination/Rosette.astro';

interface Props {
  eyebrow?: string;
  title: string;
  /** The chapter numeral, e.g. "01". */
  number?: string;
  id?: string;
  align?: 'start' | 'center';
  level?: 'h2' | 'h3';
  class?: string;
}
const { eyebrow, title, number, id, align = 'start', level: Tag = 'h2', class: className = '' } = Astro.props;
const hasAside = Astro.slots.has('default');
---

<div class:list={['rise', align === 'center' && 'text-center', className]}>
  <span aria-hidden="true" class="gilt-rule block"></span>
  <div
    class:list={[
      'mt-6 grid gap-x-8 gap-y-4',
      align === 'center' ? 'justify-items-center' : 'md:grid-cols-[minmax(4rem,auto)_1fr] md:items-start',
    ]}
  >
    {
      number ? (
        <span aria-hidden="true" class="numeral">
          {number}
        </span>
      ) : (
        <Rosette class="mt-2 size-5 text-gold" />
      )
    }
    <div class:list={[!hasAside && 'max-w-[46rem]', hasAside && 'grid gap-5 lg:grid-cols-[1.15fr_1fr] lg:items-end lg:gap-14']}>
      <div>
        {eyebrow && <p class="label">{eyebrow}</p>}
        <Tag id={id} class="display-lg mt-3">{title}</Tag>
      </div>
      {hasAside && <div class="max-w-[34rem] text-[17px] leading-[1.75] text-ink-soft lg:pb-2"><slot /></div>}
    </div>
  </div>
</div>
