---
/**
 * A program as an entry in an index: its image at the left, then its status
 * and area, title, and the same facts for every current program (audience,
 * schedule, how often, format), and the button at the right. Completed
 * programs show their year, summary, and teachers instead, with a record link.
 * Lay entries out in an `entry-list`.
 */
import { Image } from 'astro:assets';
import Icon, { type IconName } from './Icon.astro';
import { areas } from '../site.config';
import { STATUS_LABEL, programHref, programYear, resolveInstructors, rhythmLabel, type Program } from '../lib/content';

interface Props {
  program: Program;
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { program, headingLevel: Heading = 'h3' } = Astro.props;
const d = program.data;
const href = programHref(program);
const area = areas[d.area].label;
const completed = d.status === 'completed';
const eyebrow = completed ? `${programYear(program)} · ${area}` : `${STATUS_LABEL[d.status]} · ${area}`;
const teachers = completed ? (await resolveInstructors(d.instructors)).map((i) => i.name) : [];
const details: { icon: IconName; label: string; value?: string }[] = [
  { icon: 'users', label: 'Audience', value: d.audience },
  { icon: 'clock', label: 'Schedule', value: d.schedule },
  { icon: 'calendar', label: 'How often', value: rhythmLabel(program) },
  { icon: d.format === 'Online' ? 'laptop' : 'map-pin', label: 'Format', value: d.format },
];
---

<article class="rise group relative grid gap-6 py-9 md:grid-cols-[minmax(0,15rem)_1fr_auto] md:items-center md:gap-9 lg:py-11">
  <div class="relative aspect-video overflow-hidden rounded-card bg-sage-wash ring-1 ring-gold/60">
    {
      // The program's 16:9 image. Decorative here: the title beside it names it.
      d.image ? (
        <Image
          src={d.image}
          alt=""
          widths={[400, 800]}
          sizes="(min-width: 768px) 15rem, 100vw"
          class="size-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-105"
        />
      ) : (
        <svg class="absolute inset-0 size-full text-gold opacity-60" aria-hidden="true">
          <rect width="100%" height="100%" fill="url(#girih)" />
        </svg>
      )
    }
    <span aria-hidden="true" class="pointer-events-none absolute inset-1.5 rounded-[6px] border border-gold-light/80"></span>
  </div>
  <div class="min-w-0">
    <p class="label">{eyebrow}</p>
    <Heading class="display-md mt-3">
      <a href={href} class="after:absolute after:inset-0 after:content-[''] group-hover:text-raspberry-deep">{d.title}</a>
    </Heading>
    {
      completed ? (
        <>
          {d.summary && <p class="mt-3 max-w-[40rem] text-[16px] leading-relaxed text-ink-soft">{d.summary}</p>}
          <p class="mt-3 text-[15px] text-ink-soft">
            {[d.audience, d.format, teachers.length > 0 && `${teachers.slice(0, 2).join(', ')}${teachers.length > 2 ? ' and others' : ''}`]
              .filter(Boolean)
              .join(' · ')}
          </p>
        </>
      ) : (
        <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-[15px] text-ink-soft">
          {details
            .filter((x) => x.value)
            .map((x) => (
              <li class="flex items-center gap-2">
                <Icon name={x.icon} class="size-4 shrink-0 text-gold-text" />
                <span>
                  <span class="sr-only">{x.label}: </span>
                  {x.value}
                </span>
              </li>
            ))}
        </ul>
      )
    }
  </div>
  <p class="md:justify-self-end">
    {
      completed ? (
        <span class="link-arrow text-[15px]">
          View program record <Icon name="arrow-right" class="size-4" />
        </span>
      ) : (
        <span class="btn btn-outline px-6 group-hover:bg-raspberry group-hover:text-on-raspberry">View Details</span>
      )
    }
  </p>
</article>
