---
/**
 * Program teaser. Current programs show their status, then audience, schedule,
 * how often, and format, one per line in that order, and a button; completed
 * programs show year, summary, and a record link.
 */
import { Image } from 'astro:assets';
import Icon, { type IconName } from './Icon.astro';
import { areas } from '../site.config';
import { STATUS_LABEL, programHref, programYear, resolveInstructors, rhythmLabel, type Program } from '../lib/content';

interface Props {
  program: Program;
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { program, headingLevel: Heading = 'h3' } = Astro.props;
const d = program.data;
const href = programHref(program);
const area = areas[d.area].label;
const completed = d.status === 'completed';
const eyebrow = completed ? `${programYear(program)} · ${area}` : `${STATUS_LABEL[d.status]} · ${area}`;
const teachers = completed ? (await resolveInstructors(d.instructors)).map((i) => i.name) : [];
const details: { icon: IconName; label: string; value?: string }[] = [
  { icon: 'users', label: 'Audience', value: d.audience },
  { icon: 'clock', label: 'Schedule', value: d.schedule },
  { icon: 'calendar', label: 'How often', value: rhythmLabel(program) },
  { icon: d.format === 'Online' ? 'laptop' : 'map-pin', label: 'Format', value: d.format },
];
---

<article
  class="card-illuminated card-lift group flex h-full flex-col rounded-card p-6 sm:p-7"
>
  {
    // The program's 16:9 image. Decorative here: the title below names it.
    d.image && (
      <div class="-mx-6 -mt-6 mb-5 overflow-hidden rounded-t-[calc(var(--radius-card)-1px)] sm:-mx-7 sm:-mt-7">
        <Image
          src={d.image}
          alt=""
          widths={[400, 800]}
          sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw"
          class="aspect-video w-full object-cover transition-transform duration-300 motion-safe:group-hover:scale-105"
        />
      </div>
    )
  }
  <p class="text-[13px] font-bold tracking-[0.06em] text-gold-text uppercase">{eyebrow}</p>
  <Heading class="mt-2 font-display text-[1.65rem] leading-tight font-bold text-raspberry">
    <a href={href} class="after:absolute after:inset-0 after:content-['']">{d.title}</a>
  </Heading>
  {
    completed ? (
      <>
        {d.summary && <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">{d.summary}</p>}
        <div class="mt-3 space-y-0.5 text-sm text-ink-soft">
          {d.format || d.audience ? <p>{[d.audience, d.format].filter(Boolean).join(' · ')}</p> : null}
          {teachers.length > 0 && <p>{teachers.slice(0, 2).join(', ')}{teachers.length > 2 ? ' and others' : ''}</p>}
        </div>
        <p class="link-arrow mt-auto pt-5 text-[15px]">
          View program record <Icon name="arrow-right" class="size-4" />
        </p>
      </>
    ) : (
      <>
        <ul class="mt-3 space-y-1.5 text-[15px] text-ink-soft">
          {details
            .filter((x) => x.value)
            .map((x) => (
              <li class="flex gap-2.5">
                <Icon name={x.icon} class="mt-[3px] size-4 shrink-0 text-gold-text" />
                <span>
                  <span class="sr-only">{x.label}: </span>
                  {x.value}
                </span>
              </li>
            ))}
        </ul>
        <p class="mt-auto pt-6">
          <span class="btn btn-primary px-5 text-[15px] group-hover:brightness-90">View Details</span>
        </p>
      </>
    )
  }
</article>
