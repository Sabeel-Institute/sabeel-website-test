---
import { Image } from 'astro:assets';
import sprig from '../assets/decor/sprig-gold-line.png';
import Icon from './Icon.astro';
import { site } from '../site.config';
---

<section class="relative overflow-hidden bg-sage-mist" aria-labelledby="newsletter-heading">
  <Image
    src={sprig}
    alt=""
    width={180}
    class="pointer-events-none absolute -right-6 bottom-0 hidden w-[150px] opacity-80 md:block"
  />
  <div class="container-page flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between md:gap-10">
    <div class="flex items-start gap-5 md:items-center md:gap-10">
      <span class="hidden size-24 shrink-0 items-center justify-center rounded-full bg-canvas text-gold sm:flex">
        <Icon name="mail" class="size-11" strokeWidth={1.6} />
      </span>
      <div>
        <h2 id="newsletter-heading" class="font-display text-[1.7rem] font-bold tracking-wide text-raspberry uppercase">
          Stay Connected
        </h2>
        <p class="mt-1 max-w-[24rem] text-base text-ink-soft">
          Subscribe to our newsletter for updates, resources, and inspiration.
        </p>
      </div>
    </div>

    <form
      class="flex w-full max-w-md md:mr-12"
      method="post"
      action={site.newsletterFormAction ?? `mailto:${site.email}`}
      target={site.newsletterFormAction ? '_blank' : undefined}
      data-newsletter
      data-fallback-email={site.newsletterFormAction ? undefined : site.email}
    >
      <label for="newsletter-email" class="sr-only">Your email address</label>
      <input
        id="newsletter-email"
        type="email"
        name="EMAIL"
        required
        autocomplete="email"
        placeholder="Your Email Address"
        class="min-h-[52px] w-full min-w-0 rounded-l-[10px] border border-r-0 border-border-strong bg-surface px-5 text-base text-ink placeholder:text-ink-soft focus:border-raspberry focus:outline-none"
      />
      <button
        type="submit"
        class="min-h-[52px] shrink-0 rounded-r-[10px] bg-raspberry px-5 text-sm font-medium tracking-wide text-on-raspberry uppercase shadow-card transition-colors hover:bg-raspberry-deep"
      >
        Subscribe
      </button>
    </form>
  </div>
</section>

<script>
  // Without a mailing-list endpoint, subscribing opens a pre-filled email.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-fallback-email]')) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = new FormData(form).get('EMAIL');
      const to = form.dataset.fallbackEmail!;
      const subject = encodeURIComponent('Newsletter subscription');
      const body = encodeURIComponent(`Please add ${email} to the Sabeel Institute newsletter.`);
      window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
    });
  }
</script>
