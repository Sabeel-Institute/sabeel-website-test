---
/** "The Sabeel Difference" band, shared by Home and About. */
import Divider from './Divider.astro';
import Icon from './Icon.astro';

const items = [
  { icon: 'book-open', title: 'Rooted in Scholarship', text: 'Learn with ‘Alimiyyah graduates trained across the core Islamic sciences.' },
  { icon: 'users', title: 'A Place to Belong', text: 'Study face to face in Houston, among women who know your name and walk beside you.' },
  {
    icon: 'hands-heart',
    title: 'Learn. Reflect. Serve.',
    text: 'Deepened through suhbah, Sabeel’s learning endures — students who studied here over a decade ago still serve alongside us.',
  },
] as const;
---

<section class="bg-sage-mist py-14 md:py-16" aria-labelledby="difference-heading">
  <div class="container-page">
    <h2 id="difference-heading" class="text-center font-display text-[2.2rem] font-bold tracking-wide text-raspberry uppercase sm:text-[2.6rem]">
      The Sabeel Difference
    </h2>
    <Divider align="center" class="mt-3" />
    <ul class="mt-10 grid gap-10 md:grid-cols-3 md:gap-0">
      {
        items.map((item, i) => (
          <li class:list={['px-4 text-center md:px-8 md:py-2', i > 0 && 'md:border-l md:border-gold']}>
            <span class="mx-auto flex size-[70px] items-center justify-center rounded-full bg-canvas text-gold-text">
              <Icon name={item.icon} class="size-8" />
            </span>
            <h3 class="mt-5 font-display text-[1.45rem] font-bold tracking-wide text-raspberry uppercase">{item.title}</h3>
            <span class="mx-auto mt-2 block h-px w-12 bg-gold" aria-hidden="true" />
            <p class="mx-auto mt-3 max-w-[23rem] leading-[1.8] text-ink">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
