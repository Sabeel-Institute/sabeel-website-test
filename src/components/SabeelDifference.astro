---
/** "The Sabeel Difference" band, shared by Home and About: an arcade of three arches on sage. */
import Divider from './Divider.astro';
import Icon from './Icon.astro';
import Lattice from './illumination/Lattice.astro';
import ArchRim from './illumination/ArchRim.astro';

const items = [
  { icon: 'book-open', title: 'Rooted in Scholarship', text: 'Learn with ‘Alimiyyah graduates trained across the core Islamic sciences.' },
  { icon: 'users', title: 'A Place to Belong', text: 'Study face to face in Houston, among women who know your name and walk beside you.' },
  {
    icon: 'hands-heart',
    title: 'Learn. Reflect. Serve.',
    text: 'Deepened through suhbah, Sabeel’s learning endures — students who studied here over a decade ago still serve alongside us.',
  },
] as const;
---

<section class="relative overflow-clip bg-sage-mist py-20 lg:py-28" aria-labelledby="difference-heading">
  <Lattice class="text-gold opacity-[0.12]" />
  <div class="container-page relative">
    <div class="flex items-center gap-6 sm:gap-10">
      <span aria-hidden="true" class="gilt-rule hidden flex-1 sm:block"></span>
      <h2 id="difference-heading" class="display-lg text-center tracking-[0.06em] uppercase">The Sabeel Difference</h2>
      <span aria-hidden="true" class="gilt-rule hidden flex-1 sm:block"></span>
    </div>
    <Divider align="center" class="mt-5" />
    <ul class="mx-auto mt-16 grid max-w-[22rem] gap-10 md:max-w-none md:grid-cols-3 md:gap-8 lg:gap-12">
      {
        items.map((item) => (
          <li class="arch-panel rise">
            <ArchRim />
            <div class="relative flex flex-col items-center px-7 pt-[32%] pb-12 text-center">
              <span class="flex size-[76px] items-center justify-center rounded-full border border-gold/80 bg-canvas text-gold-text ring-1 ring-gold/50 ring-offset-4 ring-offset-surface">
                <Icon name={item.icon} class="size-8" />
              </span>
              <h3 class="display-md mt-7 text-[1.6rem] tracking-[0.04em] uppercase">{item.title}</h3>
              <span class="mt-4 block h-px w-12 bg-gold" aria-hidden="true" />
              <p class="mt-4 max-w-[20rem] leading-[1.8] text-ink">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
