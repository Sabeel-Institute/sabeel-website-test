---
/** A short card on a program page: its instructors, or a paragraph such as What to expect or Policies. */
import type { Instructor } from '../lib/content';

interface Props {
  title: string;
  instructors?: Instructor[];
  text?: string;
  class?: string;
}
const { title, instructors, text, class: className } = Astro.props;
---

<div class:list={['rounded-card border border-gold/60 bg-surface p-7', className]}>
  <h2 class="text-xl font-semibold text-ink">{title}</h2>
  {
    instructors ? (
      <ul class="mt-4 space-y-4">
        {instructors.map((i) => (
          <li>
            <p class="font-semibold text-raspberry">
              {i.href ? (
                <a href={i.href} class="underline decoration-gold underline-offset-4 hover:decoration-raspberry">
                  {i.name}
                </a>
              ) : (
                i.name
              )}
            </p>
            {i.role && <p class="text-[15px] text-ink-soft">{i.role}</p>}
            {i.highlights?.map((h) => <p class="text-[15px] text-ink-soft">{h}</p>)}
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-3 leading-[1.75] text-ink-soft">{text}</p>
    )
  }
</div>
