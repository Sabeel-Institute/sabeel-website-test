---
/**
 * The footer: the logo, contact, and menus under a gilt rule with a medallion,
 * then the colophon, a raspberry field with the Qur'anic verse set large.
 */
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import Icon from './Icon.astro';
import Lattice from './illumination/Lattice.astro';
import Rosette from './illumination/Rosette.astro';
import Shamsa from './illumination/Shamsa.astro';
import Divider from './Divider.astro';
import { site, footerNav } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="relative bg-canvas">
  <span aria-hidden="true" class="gilt-rule-double absolute inset-x-0 top-0"></span>
  <span
    aria-hidden="true"
    class="absolute top-0 left-1/2 flex size-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-gold/70 bg-canvas"
  >
    <Rosette class="size-6 text-gold" />
  </span>
  <div class="container-page grid gap-12 py-20 md:grid-cols-[1.4fr_1fr_1fr] md:gap-0 lg:py-24">
    <div class="md:pr-12">
      <Image src={logo} alt="Sabeel Institute" width={180} class="h-auto w-[170px]" />
      <p class="lead mt-6 max-w-[22rem] text-[1.3rem] sm:text-[1.4rem]">{site.tagline}</p>
      <p class="mt-6 flex flex-col gap-2 text-[15px] text-ink-soft">
        <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 hover:text-raspberry">
          <Icon name="mail" class="size-5 text-gold-text" />{site.email}
        </a>
        <span class="inline-flex items-center gap-2">
          <Icon name="map-pin" class="size-5 text-gold-text" />{site.location} · In person and live online
        </span>
      </p>
      <ul class="mt-6 flex gap-3" aria-label="Social media">
        <li>
          <a
            href={site.social.facebook}
            class="flex size-11 items-center justify-center rounded-full border border-gold/60 bg-surface text-gold-text transition-colors hover:bg-raspberry hover:text-on-raspberry"
          >
            <Icon name="facebook" class="size-5" label="Sabeel Institute on Facebook" />
          </a>
        </li>
        <li>
          <a
            href={site.social.instagram}
            class="flex size-11 items-center justify-center rounded-full border border-gold/60 bg-surface text-gold-text transition-colors hover:bg-raspberry hover:text-on-raspberry"
          >
            <Icon name="instagram" class="size-5" label="Sabeel Institute on Instagram" />
          </a>
        </li>
      </ul>
    </div>

    {
      footerNav.map((col) => (
        <nav aria-label={col.title} class="md:border-l md:border-gold/60 md:px-12">
          <h2 class="label">{col.title}</h2>
          <ul class="mt-4">
            {col.links.map((item) => (
              <li>
                <a href={item.href} class="flex min-h-11 items-center font-display text-[1.35rem] font-semibold text-ink hover:text-raspberry">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="relative overflow-clip bg-raspberry text-on-raspberry">
    <Lattice class="text-gold opacity-[0.16]" />
    <Shamsa class="turn absolute top-1/2 left-1/2 w-[52rem] max-w-none -translate-x-1/2 -translate-y-1/2 text-gold opacity-[0.12]" />
    <div class="container-page relative py-16 text-center lg:py-24">
      <Divider align="center" />
      <p class="mx-auto mt-8 max-w-[36rem] font-display text-[1.7rem] leading-[1.3] font-medium italic sm:text-[2.2rem] lg:text-[2.6rem]">
        “And say, My Lord, increase me in knowledge.”
      </p>
      <p class="label mt-5 text-gold">(Qur'an 20:114)</p>
      <p class="mt-14 text-sm font-medium">© {year} Sabeel Institute</p>
    </div>
  </div>
</footer>
