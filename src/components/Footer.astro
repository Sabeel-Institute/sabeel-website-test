---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import sprig from '../assets/decor/sprig-gold.png';
import Icon from './Icon.astro';
import { site, footerNav } from '../site.config';
import { hasPosts } from '../lib/content';

const links = footerNav.filter((item) => item.href !== '/blog/' || hasPosts);
const year = new Date().getFullYear();
---

<footer class="bg-canvas">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.15fr_1fr_0.9fr] md:gap-0">
    <div class="md:pr-10">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
        <Image src={logo} alt="Sabeel Institute" width={170} class="h-auto w-[150px] shrink-0" />
        <p class="max-w-[19rem] text-base leading-[1.8] text-ink-soft">
          Sabeel Institute is dedicated to nurturing hearts, minds, and souls through authentic Islamic
          education and sisterhood.
        </p>
      </div>
      <ul class="mt-6 flex gap-3" aria-label="Social media">
        <li>
          <a
            href={site.social.facebook}
            class="flex size-12 items-center justify-center rounded-full bg-surface text-gold-text shadow-card transition-colors hover:bg-raspberry hover:text-on-raspberry"
          >
            <Icon name="facebook" class="size-5" label="Sabeel Institute on Facebook" />
          </a>
        </li>
        <li>
          <a
            href={site.social.instagram}
            class="flex size-12 items-center justify-center rounded-full bg-surface text-gold-text shadow-card transition-colors hover:bg-raspberry hover:text-on-raspberry"
          >
            <Icon name="instagram" class="size-5" label="Sabeel Institute on Instagram" />
          </a>
        </li>
      </ul>
    </div>

    <nav aria-labelledby="footer-links" class="md:border-l md:border-gold md:px-10">
      <h2 id="footer-links" class="text-lg font-medium tracking-wide text-raspberry uppercase">Quick Links</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-6">
        {
          links.map((item) => (
            <li>
              <a href={item.href} class="flex min-h-11 items-center text-base text-ink-soft hover:text-raspberry">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="md:border-l md:border-gold md:pl-10">
      <h2 class="text-lg font-medium text-raspberry">Contact Us</h2>
      <ul class="mt-5 space-y-5 text-base text-ink-soft">
        <li>
          <a href={`mailto:${site.email}`} class="flex items-center gap-3 hover:text-raspberry">
            <Icon name="mail" class="size-6 shrink-0 text-gold-text" />
            {site.email}
          </a>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="map-pin" class="mt-0.5 size-6 shrink-0 text-gold-text" />
          <span>{site.location} — classes in person and online</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="bg-raspberry text-on-raspberry">
    <div class="container-page flex flex-col items-center gap-3 py-6 text-center md:flex-row md:justify-between md:text-left">
      <Image src={sprig} alt="" width={96} class="hidden h-auto w-[88px] md:block" />
      <p class="text-[15px] leading-relaxed">
        “And say, My Lord, increase me in knowledge.” (Qur'an 20:114)
      </p>
      <p class="text-sm font-medium">© {year} Sabeel Institute. All rights reserved.</p>
    </div>
  </div>
</footer>
