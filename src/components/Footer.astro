---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import sprig from '../assets/decor/sprig-gold.png';
import Icon from './Icon.astro';
import { site, footerNav } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="border-t border-gold/50 bg-canvas">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.3fr_1fr_1fr] md:gap-0">
    <div class="md:pr-10">
      <Image src={logo} alt="Sabeel Institute" width={170} class="h-auto w-[140px]" />
      <p class="mt-4 max-w-[20rem] text-base leading-[1.75] text-ink-soft">{site.tagline}</p>
      <p class="mt-4 flex flex-col gap-2 text-[15px] text-ink-soft">
        <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 hover:text-raspberry">
          <Icon name="mail" class="size-5 text-gold-text" />{site.email}
        </a>
        <span class="inline-flex items-center gap-2">
          <Icon name="map-pin" class="size-5 text-gold-text" />{site.location} · In person and live online
        </span>
      </p>
      <ul class="mt-5 flex gap-3" aria-label="Social media">
        <li>
          <a
            href={site.social.facebook}
            class="flex size-11 items-center justify-center rounded-full bg-surface text-gold-text shadow-card transition-colors hover:bg-raspberry hover:text-on-raspberry"
          >
            <Icon name="facebook" class="size-5" label="Sabeel Institute on Facebook" />
          </a>
        </li>
        <li>
          <a
            href={site.social.instagram}
            class="flex size-11 items-center justify-center rounded-full bg-surface text-gold-text shadow-card transition-colors hover:bg-raspberry hover:text-on-raspberry"
          >
            <Icon name="instagram" class="size-5" label="Sabeel Institute on Instagram" />
          </a>
        </li>
      </ul>
    </div>

    {
      footerNav.map((col) => (
        <nav aria-label={col.title} class="md:border-l md:border-gold md:px-10">
          <h2 class="text-lg font-semibold text-raspberry">{col.title}</h2>
          <ul class="mt-3">
            {col.links.map((item) => (
              <li>
                <a href={item.href} class="flex min-h-10 items-center text-base text-ink-soft hover:text-raspberry">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="bg-raspberry text-on-raspberry">
    <div class="container-page flex flex-col items-center gap-3 py-5 text-center md:flex-row md:justify-between md:text-left">
      <Image src={sprig} alt="" width={96} class="hidden h-auto w-[80px] md:block" />
      <p class="text-[15px] leading-relaxed">“And say, My Lord, increase me in knowledge.” (Qur'an 20:114)</p>
      <p class="text-sm font-medium">© {year} Sabeel Institute</p>
    </div>
  </div>
</footer>
