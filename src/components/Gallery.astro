---
/**
 * Photos from past programs as an arcade: a row of arches at one height that
 * people swipe through on a phone or move along with the arrows; it never
 * moves by itself. A photo from a program has the program's name and year
 * under it, linked to its page.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import ArchRim from './illumination/ArchRim.astro';
import type { GalleryPhoto } from '../lib/content';

interface Props {
  photos: GalleryPhoto[];
  /** The chapter numeral shown with the heading. */
  number?: string;
}

const { photos, number } = Astro.props;
/** The tallest an arch shows (lg:h-[26rem]); image files are made for it. */
const HEIGHT = 416;
/** Arrows sit level with the middle of the arches. */
const arrow =
  'absolute top-[11rem] z-10 hidden size-11 -translate-y-1/2 items-center justify-center rounded-full border border-gold/60 bg-surface/95 text-ink shadow-card transition-opacity hover:bg-white disabled:pointer-events-none disabled:opacity-0 sm:flex lg:top-[14rem]';
---

<section class="py-20 lg:py-28" aria-labelledby="gallery-heading">
  <div class="container-page">
    <SectionHeading eyebrow="Life at Sabeel" title="Moments from our programs" id="gallery-heading" number={number}>
      <p>Photos from recent classes, gatherings, and camps.</p>
      <a href="/past-programs/" class="link-arrow mt-3 font-semibold">
        Browse past programs <Icon name="arrow-right" class="size-5" />
      </a>
    </SectionHeading>
    <div class="rise relative mt-12" data-gallery>
      <ul
        tabindex="0"
        aria-labelledby="gallery-heading"
        class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-6 overflow-x-auto px-4 pt-4 pb-6 [scrollbar-color:var(--color-gold)_transparent] [scrollbar-width:thin] motion-safe:scroll-smooth sm:-mx-6 sm:scroll-px-6 sm:px-6 lg:-mx-3 lg:scroll-px-3 lg:px-3"
      >
        {
          photos.map((photo) => (
            <li class="shrink-0 snap-start">
              <figure>
                <div class="relative aspect-[5/6] h-[18rem] sm:h-[22rem] lg:h-[26rem]">
                  <div class="absolute inset-0 overflow-hidden [clip-path:url(#arch)]">
                    <Image
                      src={photo.image}
                      alt={photo.alt}
                      width={Math.round((HEIGHT * 5) / 6)}
                      height={HEIGHT}
                      densities={[1, 2]}
                      class="size-full object-cover"
                    />
                  </div>
                  <ArchRim finial={false} />
                </div>
                {photo.program && (
                  <figcaption class="mt-4 w-0 min-w-full text-center text-[15px] leading-snug">
                    <a href={photo.program.href} class="font-semibold text-raspberry underline decoration-gold underline-offset-4 hover:decoration-raspberry">
                      {photo.program.title}
                    </a>
                    <span class="text-ink-soft"> · {photo.program.year}</span>
                  </figcaption>
                )}
              </figure>
            </li>
          ))
        }
      </ul>
      <button type="button" data-gallery-prev disabled class:list={[arrow, 'left-1 lg:-left-2']}>
        <Icon name="chevron-left" class="size-6" label="Previous photos" />
      </button>
      <button type="button" data-gallery-next disabled class:list={[arrow, 'right-1 lg:-right-2']}>
        <Icon name="chevron-right" class="size-6" label="Next photos" />
      </button>
    </div>
  </div>
</section>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const list = gallery.querySelector('ul')!;
    const prev = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]')!;
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]')!;
    // An arrow shows only while there is more to see in its direction.
    const update = () => {
      prev.disabled = list.scrollLeft <= 1;
      next.disabled = list.scrollLeft + list.clientWidth >= list.scrollWidth - 1;
    };
    // The list's scroll-behavior keeps this instant when motion is reduced.
    const step = (direction: number) => list.scrollBy({ left: direction * list.clientWidth * 0.8 });
    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    list.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(list);
  }
</script>
