---
/** Course teaser from the remake's "Open for Registration" row. */
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  course: CollectionEntry<'courses'>;
  headingLevel?: 'h2' | 'h3';
}

const { course, headingLevel: Heading = 'h3' } = Astro.props;
const { title, category, summary, dates } = course.data;
const href = `/courses/${course.id}/`;
---

<article
  class="group relative flex h-full flex-col rounded-card border border-gold/70 border-t-4 border-t-gold bg-surface p-7 transition-shadow duration-200 hover:shadow-card"
>
  <p class="font-display text-xl font-bold text-gold-text">{category}</p>
  <Heading class="mt-1 text-xl leading-snug font-semibold text-raspberry">
    <a href={href} class="after:absolute after:inset-0 after:content-['']">{title}</a>
  </Heading>
  {
    dates && (
      <p class="mt-2 flex items-center gap-2 text-[15px] text-ink-soft">
        <Icon name="calendar" class="size-4 shrink-0 text-gold-text" />
        {dates}
      </p>
    )
  }
  <p class="mt-3 text-base leading-relaxed text-ink-soft">{summary}</p>
  <p class="link-arrow mt-auto pt-6 text-[17px] group-hover:gap-3">
    View Course Details <Icon name="arrow-right" class="size-5" />
  </p>
</article>
