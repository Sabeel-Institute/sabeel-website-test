---
/** A gilt hairline with a rosette at its centre, used under eyebrows and headings. */
import Rosette from './illumination/Rosette.astro';

interface Props {
  align?: 'start' | 'center';
  width?: 'sm' | 'md';
  class?: string;
}
const { align = 'start', width = 'md', class: className = '' } = Astro.props;
---

<span
  aria-hidden="true"
  class:list={[
    'flex items-center',
    width === 'sm' ? 'w-[110px]' : 'w-[160px]',
    align === 'center' && 'mx-auto',
    className,
  ]}
>
  <span
    class:list={['h-px flex-1 bg-linear-to-r via-gold to-gold-light', align === 'center' ? 'from-transparent' : 'from-gold-deep']}
  ></span>
  <Rosette class="mx-0.5 size-3.5 text-gold" />
  <span class="h-px flex-1 bg-linear-to-r from-gold-light via-gold to-transparent"></span>
</span>
