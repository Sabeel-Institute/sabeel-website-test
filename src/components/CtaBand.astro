---
/** Closing call-to-action band: heading and text on the left, buttons on the right. */
interface Props {
  title: string;
  eyebrow?: string;
  tone?: 'sage' | 'mist';
}
const { title, eyebrow, tone = 'sage' } = Astro.props;
---

<section class:list={['border-t border-border py-12 md:py-14', tone === 'sage' ? 'bg-sage-wash' : 'bg-sage-mist']}>
  <div class="container-page grid items-center gap-6 md:grid-cols-[1.1fr_1fr] md:gap-12">
    <div>
      {eyebrow && <p class="text-[15px] font-bold tracking-[0.04em] text-raspberry uppercase">{eyebrow}</p>}
      <h2 class="font-display text-[2rem] leading-tight font-bold text-raspberry sm:text-[2.3rem]">{title}</h2>
      <div class="mt-2 max-w-[38rem] leading-[1.75] text-ink"><slot /></div>
    </div>
    <div class="flex flex-wrap items-center gap-3 md:justify-end">
      <slot name="actions" />
    </div>
  </div>
</section>
