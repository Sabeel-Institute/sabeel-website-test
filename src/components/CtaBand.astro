---
/**
 * Closing call-to-action band: heading and text on the left, buttons on the
 * right. The only section in the stronger sage (see Design rules in AGENTS.md),
 * ruled like an illuminated page.
 */
import Lattice from './illumination/Lattice.astro';
import Frame from './illumination/Frame.astro';

interface Props {
  title: string;
  eyebrow?: string;
}
const { title, eyebrow } = Astro.props;
---

<section class="relative overflow-clip border-t border-border bg-sage-wash py-20 lg:py-24">
  <Lattice class="text-gold opacity-[0.14]" />
  <Frame />
  <div class="container-page relative grid items-center gap-8 md:grid-cols-[1.2fr_1fr] md:gap-12">
    <div>
      {eyebrow && <p class="label text-raspberry">{eyebrow}</p>}
      <h2 class="display-lg mt-3">{title}</h2>
      <div class="mt-4 max-w-[38rem] text-[17px] leading-[1.75] text-ink"><slot /></div>
    </div>
    <div class="flex flex-wrap items-center gap-3 md:justify-end">
      <slot name="actions" />
    </div>
  </div>
</section>
