---
/**
 * A named photo slot. Drop `src/assets/photos/<slot>.jpg` (or .png/.webp) in
 * place and it appears here; until then the slot shows a geometric panel, so
 * no page ever shows a stock or placeholder photograph. Team cards and bio
 * pages have no slot (see AGENTS.md).
 *
 * The photo is mounted in a gilt frame: a hairline inset from the edge, or,
 * with `shape="arch"`, a pointed arch with a gilt rim and a finial (ArchRim).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon, { type IconName } from './Icon.astro';
import ArchRim from './illumination/ArchRim.astro';

interface Props {
  /** Named slot in src/assets/photos/. */
  slot?: string;
  /** A specific image instead of a named slot. */
  image?: ImageMetadata;
  alt: string;
  /** Tailwind aspect/size classes for the frame. */
  class?: string;
  /** Shown centred on the geometric panel when there is no photo. */
  icon?: IconName;
  sizes?: string;
  eager?: boolean;
  /** Smaller centre medallion for small tiles. */
  compact?: boolean;
  /** A rounded rectangle, or a pointed arch. */
  shape?: 'rect' | 'arch';
}

const {
  slot,
  image,
  alt,
  class: className = 'aspect-[4/3]',
  icon,
  sizes = '(min-width: 1024px) 50vw, 100vw',
  eager = false,
  compact = false,
  shape = 'rect',
} = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const match = slot ? Object.entries(files).find(([path]) => path.replace(/^.*\//, '').replace(/\.\w+$/, '') === slot) : undefined;
const src = image ?? match?.[1].default;
const arch = shape === 'arch';
---

<div class:list={['relative', !arch && 'overflow-hidden rounded-card shadow-card', className]}>
  <div class:list={['absolute inset-0 overflow-hidden', arch && '[clip-path:url(#arch)]']}>
    {
      src ? (
        <Image
          src={src}
          alt={alt}
          widths={[480, 720, 960, 1280]}
          sizes={sizes}
          class="absolute inset-0 size-full object-cover"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
        />
      ) : (
        <div class="absolute inset-0 bg-sage-wash" role="presentation">
          <svg class="absolute inset-0 size-full opacity-60" aria-hidden="true">
            <rect width="100%" height="100%" fill="url(#girih)" />
          </svg>
          {icon && (
            <div class="absolute inset-0 flex items-center justify-center">
              <span
                class:list={[
                  'flex items-center justify-center rounded-full border border-gold bg-canvas text-raspberry shadow-card',
                  compact ? 'size-16' : 'size-28 sm:size-32',
                ]}
              >
                <Icon name={icon} class={compact ? 'size-7' : 'size-12'} strokeWidth={1.4} />
              </span>
            </div>
          )}
        </div>
      )
    }
  </div>
  {
    arch ? (
      <ArchRim />
    ) : (
      <span aria-hidden="true" class="pointer-events-none absolute inset-1.5 rounded-[6px] border border-gold-light/80" />
    )
  }
</div>
