---
import { displayName, teamHasPage, type TeamMember } from '../lib/content';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const { role, sub, highlights } = member.data;
const href = teamHasPage(member) ? `/teachers-and-team/${member.id}/` : undefined;
---

<article id={member.id} class="card-illuminated card-lift rise flex h-full scroll-mt-6 flex-col rounded-card p-7">
  {role && <p class="label">{role}</p>}
  <h3 class="display-md mt-3">
    {href ? <a href={href} class="after:absolute after:inset-0 after:content-['']">{displayName(member)}</a> : displayName(member)}
  </h3>
  {sub && <p class="mt-2 text-[15px] text-ink">{sub}</p>}
  {
    highlights && (
      <ul class="mt-4 space-y-1 text-[15px] leading-snug text-ink-soft">
        {highlights.map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    )
  }
  {href && <p class="link-arrow mt-auto pt-6 text-[15px]">Read bio</p>}
</article>
