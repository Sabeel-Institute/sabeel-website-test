---
import { displayName, teamHasPage, type TeamMember } from '../lib/content';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const { role, sub, highlights } = member.data;
const href = teamHasPage(member) ? `/teachers-and-team/${member.id}/` : undefined;
---

<article class="relative flex h-full flex-col rounded-card border border-border bg-surface p-5 transition-shadow hover:shadow-card">
  <h3 class="font-display text-[1.45rem] leading-tight font-bold text-raspberry">
    {href ? <a href={href} class="after:absolute after:inset-0 after:content-['']">{displayName(member)}</a> : displayName(member)}
  </h3>
  {role && <p class="mt-1.5 text-[15px] font-medium text-ink">{role}</p>}
  {sub && <p class="text-[14px] text-ink-soft">{sub}</p>}
  {
    highlights && (
      <ul class="mt-2 space-y-1 text-[14px] leading-snug text-ink-soft">
        {highlights.map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    )
  }
  {href && <p class="mt-3 text-[15px] font-medium text-raspberry">Read bio</p>}
</article>
