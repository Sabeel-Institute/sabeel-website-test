---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { displayName, initials, teamHasPage, type TeamMember } from '../lib/content';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const { name, role, sub, highlights, photo } = member.data;
const href = teamHasPage(member) ? `/teachers-and-team/${member.id}/` : undefined;
---

<article class="group relative flex h-full flex-col rounded-card border border-border bg-surface p-6 transition-shadow hover:shadow-card sm:p-7">
  {
    photo ? (
      <Image src={photo} alt="" width={128} class="size-16 rounded-full object-cover" />
    ) : (
      <span
        aria-hidden="true"
        class="flex size-16 items-center justify-center rounded-full border border-gold/60 bg-sage-mist font-display text-2xl font-semibold text-raspberry"
      >
        {initials(name)}
      </span>
    )
  }
  <h3 class="mt-5 text-xl leading-snug font-semibold text-ink">
    {href ? <a href={href} class="after:absolute after:inset-0 after:content-['']">{displayName(member)}</a> : displayName(member)}
  </h3>
  {role && <p class="mt-1 text-[15px] font-medium text-gold-text">{role}</p>}
  {sub && <p class="mt-0.5 text-[14px] text-ink-soft">{sub}</p>}
  {
    highlights && (
      <ul class="mt-4 space-y-2 text-[15px] leading-snug text-ink-soft">
        {highlights.map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    )
  }
  {
    href && (
      <p class="link-arrow mt-auto pt-5 text-[15px]">
        Read bio <Icon name="arrow-right" class="size-4" />
      </p>
    )
  }
</article>
