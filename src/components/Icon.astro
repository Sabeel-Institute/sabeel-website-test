export type IconName = keyof typeof icons | keyof typeof filledIcons;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
  strokeWidth?: number;
}

const { name, class: className = 'size-5', label, strokeWidth = 1.75 } = Astro.props;
const filled = name in filledIcons;
const body = filled
  ? filledIcons[name as keyof typeof filledIcons]
  : icons[name as keyof typeof icons];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={className}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={label ? `<title>${label}</title>${body}` : body}
/>
