---
/** A ledger of labelled facts (Audience, Starts, Schedule, Location ...) between gilt rules; a fact can add links under its value, such as map links. */
import Icon from './Icon.astro';

interface Props {
  facts: { label: string; value?: string; links?: { text: string; href: string }[] }[];
  class?: string;
}
const { facts, class: className = '' } = Astro.props;
const shown = facts.filter((f) => f.value);
---

<dl
  class:list={[
    'rise grid gap-x-8 gap-y-8 border-y border-gold/50 py-9 sm:grid-cols-2',
    shown.length >= 4 ? 'lg:grid-cols-4' : shown.length === 3 ? 'lg:grid-cols-3' : '',
    className,
  ]}
>
  {
    shown.map((f) => (
      <div class="sm:border-l sm:border-gold/40 sm:pl-6 sm:first:border-l-0 sm:first:pl-0">
        <dt class="label">{f.label}</dt>
        <dd class="mt-3 font-display text-[1.5rem] leading-[1.2] font-semibold text-ink">{f.value}</dd>
        {f.links?.map((l) => (
          <dd class="mt-2">
            <a
              href={l.href}
              target="_blank"
              rel="noopener"
              class="inline-flex gap-1.5 text-[15px] font-medium text-raspberry underline decoration-gold underline-offset-4 hover:decoration-raspberry"
            >
              <Icon name="map-pin" class="mt-[3px] size-4 shrink-0" />
              <span>
                {l.text}
                <span class="sr-only"> (map, opens in a new tab)</span>
              </span>
            </a>
          </dd>
        ))}
      </div>
    ))
  }
</dl>
