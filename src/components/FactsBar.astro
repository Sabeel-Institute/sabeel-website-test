---
/** Row of labelled facts (Audience, Starts, Schedule, Location ...); a fact can add links under its value, such as map links. */
import Icon from './Icon.astro';

interface Props {
  facts: { label: string; value?: string; links?: { text: string; href: string }[] }[];
  class?: string;
}
const { facts, class: className = '' } = Astro.props;
const shown = facts.filter((f) => f.value);
---

<dl
  class:list={[
    'card-illuminated grid overflow-hidden rounded-card sm:grid-cols-2',
    shown.length >= 4 ? 'lg:grid-cols-4' : shown.length === 3 ? 'lg:grid-cols-3' : '',
    className,
  ]}
>
  {
    shown.map((f) => (
      <div class="border-b border-gold/40 px-5 py-4 last:border-b-0 sm:border-r sm:[&:nth-child(2n)]:border-r-0 lg:border-b-0 lg:[&:nth-child(2n)]:border-r lg:last:border-r-0">
        <dt class="text-sm text-ink-soft">{f.label}</dt>
        <dd class="mt-0.5 text-[17px] font-semibold text-ink">{f.value}</dd>
        {f.links?.map((l) => (
          <dd class="mt-1">
            <a
              href={l.href}
              target="_blank"
              rel="noopener"
              class="inline-flex gap-1.5 text-[15px] font-medium text-raspberry underline decoration-gold underline-offset-4 hover:decoration-raspberry"
            >
              <Icon name="map-pin" class="mt-[3px] size-4 shrink-0" />
              <span>
                {l.text}
                <span class="sr-only"> (map, opens in a new tab)</span>
              </span>
            </a>
          </dd>
        ))}
      </div>
    ))
  }
</dl>
