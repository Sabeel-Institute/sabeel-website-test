---
/** Program-area page: what is open now in the area, then its past programs by year. */
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import SectionHeading from './SectionHeading.astro';
import ProgramCard from './ProgramCard.astro';
import CtaBand from './CtaBand.astro';
import CurrentPrograms from './CurrentPrograms.astro';
import Lightbox from './Lightbox.astro';
import Icon from './Icon.astro';
import { areas, type AreaId } from '../site.config';
import { getCompletedPrograms, getCurrentPrograms, getUpcomingPrograms, programHref, programYear } from '../lib/content';

interface Props {
  area: AreaId;
  intro: string;
}
const { area: id, intro } = Astro.props;
const area = areas[id];
const current = await getCurrentPrograms(id);
const upcoming = await getUpcomingPrograms(id);
const past = await getCompletedPrograms(id);

const yearsMap = new Map<number, typeof past>();
for (const p of past) {
  const y = programYear(p);
  if (!yearsMap.has(y)) yearsMap.set(y, []);
  yearsMap.get(y)!.push(p);
}

const sortedYears = Array.from(yearsMap.keys()).sort((a, b) => b - a);
const defaultYear = sortedYears.includes(2026) ? 2026 : sortedYears[0];

const pastWithFlyer = await Promise.all(
  past.map(async (p) => {
    const flyer = p.data.flyer ?? p.data.image;
    const flyerFull = flyer ? await getImage({ src: flyer, width: 1600 }) : null;
    return {
      program: p,
      year: programYear(p),
      href: programHref(p),
      flyer,
      flyerFullSrc: flyerFull?.src,
    };
  })
);
---

<BaseLayout title={area.label} description={area.description}>
  <PageHero eyebrow="Program area" title={area.label} photo={`area-${id}`} photoAlt={area.label} photoIcon={area.icon}>
    <p>{intro}</p>
  </PageHero>

  <section class="bg-sage-wash py-14 md:py-16" aria-labelledby="current-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Now enrolling" title={`Current ${area.label.toLowerCase()} programs`} id="current-heading" />
      {
        current.length > 0 ? (
          <CurrentPrograms programs={current} />
        ) : (
          <p class="mt-10 rounded-card bg-surface p-7 text-ink-soft">
            Nothing is open in this area right now.
            <a href="/contact/?inquiry=interest-list" data-interest class="font-medium text-raspberry underline decoration-gold underline-offset-4">
              Join the interest list
            </a>{' '}
            to hear when the next program opens.
          </p>
        )
      }
      {
        upcoming.length > 0 && (
          <div class="mt-12">
            <h3 class="border-b border-gold/60 pb-3 font-display text-[1.75rem] font-bold text-raspberry">Coming soon</h3>
            <ul class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {upcoming.map((p) => (
                <li>
                  <ProgramCard program={p} headingLevel="h4" />
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  {
    past.length > 0 && (
      <section id="past" class="scroll-mt-6 py-14 md:py-16" aria-labelledby="past-heading">
        <div class="container-page">
          <SectionHeading eyebrow="Program archive" title="Past programs" id="past-heading">
            <p>{area.archiveText}</p>
          </SectionHeading>

          <!-- Year Selection Tabs -->
          <div class="mt-8 flex flex-wrap items-center justify-center gap-2 md:gap-3" role="tablist" aria-label="Select year">
            {sortedYears.map((year) => (
              <button
                type="button"
                role="tab"
                data-area-year-tab={String(year)}
                aria-selected={year === defaultYear ? 'true' : 'false'}
                class:list={[
                  'px-5 py-2 rounded-full font-display font-bold text-lg transition-all duration-150 cursor-pointer border',
                  year === defaultYear
                    ? 'bg-raspberry text-on-raspberry border-raspberry shadow-sm'
                    : 'bg-surface text-ink-soft border-gold/40 hover:border-gold hover:text-raspberry',
                ]}
              >
                {year}
              </button>
            ))}
          </div>

          <!-- Year Panels with Flyer Grids -->
          <div class="mt-10">
            {sortedYears.map((year) => {
              const yearPrograms = pastWithFlyer.filter((item) => item.year === year);
              return (
                <div
                  data-area-year-panel={String(year)}
                  role="tabpanel"
                  hidden={year !== defaultYear}
                  class="focus:outline-none"
                >
                  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                    {yearPrograms.map((item) => (
                      <article class="group relative flex flex-col rounded-card border border-gold/40 bg-surface overflow-hidden shadow-sm hover:shadow-card transition-shadow">
                        <div class="relative aspect-[3/4] w-full overflow-hidden bg-sage-wash/30">
                          {item.flyer ? (
                            <a
                              href={item.flyerFullSrc ?? item.href}
                              data-lightbox={`area-flyers-${id}`}
                              data-title={item.program.data.title}
                              data-caption={`${item.year} · ${area.label}`}
                              data-page={item.href}
                              class="block size-full"
                            >
                              <Image
                                src={item.flyer}
                                alt={`Flyer for ${item.program.data.title}`}
                                widths={[320, 640]}
                                sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw"
                                class="size-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
                              />
                            </a>
                          ) : (
                            <div class="flex size-full items-center justify-center bg-sage-wash p-4 text-center">
                              <span class="font-display font-bold text-raspberry text-lg">{item.program.data.title}</span>
                            </div>
                          )}
                        </div>
                        <div class="p-4 flex flex-col flex-1 justify-between gap-2 border-t border-gold/20">
                          <div>
                            <h3 class="font-display font-bold text-lg text-raspberry leading-tight mt-1">
                              <a href={item.href} class="hover:underline">
                                {item.program.data.title}
                              </a>
                            </h3>
                          </div>
                          <a href={item.href} class="link-arrow text-xs font-medium pt-2 mt-auto">
                            View details <Icon name="arrow-right" class="size-3.5" />
                          </a>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand title="Looking for something else?">
    <p>See everything open for registration across all three program areas.</p>
    <a slot="actions" href="/programs/" class="btn btn-primary px-7 text-base">View All Programs</a>
  </CtaBand>

  <Lightbox />
</BaseLayout>

<script>
  function setupAreaYearTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-area-year-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-area-year-panel]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetYear = tab.dataset.areaYearTab;

        tabs.forEach((t) => {
          const active = t.dataset.areaYearTab === targetYear;
          t.setAttribute('aria-selected', active ? 'true' : 'false');
          if (active) {
            t.classList.remove('bg-surface', 'text-ink-soft', 'border-gold/40');
            t.classList.add('bg-raspberry', 'text-on-raspberry', 'border-raspberry', 'shadow-sm');
          } else {
            t.classList.remove('bg-raspberry', 'text-on-raspberry', 'border-raspberry', 'shadow-sm');
            t.classList.add('bg-surface', 'text-ink-soft', 'border-gold/40');
          }
        });

        panels.forEach((p) => {
          p.hidden = p.dataset.areaYearPanel !== targetYear;
        });
      });
    });
  }

  setupAreaYearTabs();
  document.addEventListener('astro:page-load', setupAreaYearTabs);
</script>
