---
/** Program-area page: what is open now in the area, what is coming soon, and what is running with registration closed. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import SectionHeading from './SectionHeading.astro';
import ProgramCard from './ProgramCard.astro';
import CtaBand from './CtaBand.astro';
import CurrentPrograms from './CurrentPrograms.astro';
import { areas, type AreaId } from '../site.config';
import { STATUS_LABEL, getClosedPrograms, getCurrentPrograms, getUpcomingPrograms } from '../lib/content';

interface Props {
  area: AreaId;
  intro: string;
}
const { area: id, intro } = Astro.props;
const area = areas[id];
const current = await getCurrentPrograms(id);
const notJoinable = [
  { title: STATUS_LABEL.upcoming, programs: await getUpcomingPrograms(id) },
  { title: STATUS_LABEL.closed, programs: await getClosedPrograms(id) },
].filter((l) => l.programs.length > 0);
---

<BaseLayout title={area.label} description={area.description}>
  <PageHero eyebrow="Program area" title={area.label} photo={`area-${id}`} photoAlt={area.label} photoIcon={area.icon}>
    <p>{intro}</p>
  </PageHero>

  <section class="py-20 lg:py-28" aria-labelledby="current-heading">
    <div class="container-page">
      <SectionHeading number="01" eyebrow="Now enrolling" title={`Current ${area.label.toLowerCase()} programs`} id="current-heading" />
      {
        current.length > 0 ? (
          <CurrentPrograms programs={current} />
        ) : (
          <p class="card-illuminated mt-10 rounded-card p-7 text-ink-soft">
            Nothing is open in this area right now.
            <a href="/contact/?inquiry=interest-list" data-interest class="font-medium text-raspberry underline decoration-gold underline-offset-4">
              Join the interest list
            </a>{' '}
            to hear when the next program opens.
          </p>
        )
      }
      {
        notJoinable.map((l) => (
          <div class="mt-16">
            <h3 class="display-md border-b border-gold/60 pb-4">{l.title}</h3>
            <ul class="entry-list">
              {l.programs.map((p) => (
                <li>
                  <ProgramCard program={p} headingLevel="h4" />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <CtaBand title="Looking for something else?">
    <p>See everything open for registration across all three program areas, or look back at past programs.</p>
    <a slot="actions" href="/programs/" class="btn btn-primary px-7 text-base">View All Programs</a>
    <a slot="actions" href="/past-programs/" class="btn btn-outline px-6 text-base">Past Programs</a>
  </CtaBand>
</BaseLayout>
