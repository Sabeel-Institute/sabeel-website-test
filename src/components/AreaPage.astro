---
/** Program-area page: what is open now in the area, then its past programs' flyers by year. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import SectionHeading from './SectionHeading.astro';
import ProgramCard from './ProgramCard.astro';
import CtaBand from './CtaBand.astro';
import CurrentPrograms from './CurrentPrograms.astro';
import FlyerArchive from './FlyerArchive.astro';
import Lightbox from './Lightbox.astro';
import { areas, type AreaId } from '../site.config';
import { getCompletedPrograms, getCurrentPrograms, getUpcomingPrograms } from '../lib/content';

interface Props {
  area: AreaId;
  intro: string;
}
const { area: id, intro } = Astro.props;
const area = areas[id];
const current = await getCurrentPrograms(id);
const upcoming = await getUpcomingPrograms(id);
const past = await getCompletedPrograms(id);
---

<BaseLayout title={area.label} description={area.description}>
  <PageHero eyebrow="Program area" title={area.label} photo={`area-${id}`} photoAlt={area.label} photoIcon={area.icon}>
    <p>{intro}</p>
  </PageHero>

  <section class="bg-sage-wash py-14 md:py-16" aria-labelledby="current-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Now enrolling" title={`Current ${area.label.toLowerCase()} programs`} id="current-heading" />
      {
        current.length > 0 ? (
          <CurrentPrograms programs={current} />
        ) : (
          <p class="mt-10 rounded-card bg-surface p-7 text-ink-soft">
            Nothing is open in this area right now.
            <a href="/contact/?inquiry=interest-list" data-interest class="font-medium text-raspberry underline decoration-gold underline-offset-4">
              Join the interest list
            </a>{' '}
            to hear when the next program opens.
          </p>
        )
      }
      {
        upcoming.length > 0 && (
          <div class="mt-12">
            <h3 class="border-b border-gold/60 pb-3 font-display text-[1.75rem] font-bold text-raspberry">Coming soon</h3>
            <ul class="card-grid mt-6">
              {upcoming.map((p) => (
                <li>
                  <ProgramCard program={p} headingLevel="h4" />
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  {
    past.length > 0 && (
      <section id="past" class="scroll-mt-6 py-14 md:py-16" aria-labelledby="past-heading">
        <div class="container-page">
          <SectionHeading eyebrow="Program archive" title="Past programs" id="past-heading">
            <p>{area.archiveText}</p>
          </SectionHeading>
          <div class="mt-10">
            <FlyerArchive programs={past} id="past" />
          </div>
        </div>
      </section>
    )
  }

  <CtaBand title="Looking for something else?">
    <p>See everything open for registration across all three program areas.</p>
    <a slot="actions" href="/programs/" class="btn btn-primary px-7 text-base">View All Programs</a>
  </CtaBand>
  <Lightbox />
</BaseLayout>
