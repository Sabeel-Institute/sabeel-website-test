---
/**
 * A Zeffy form (the donation form, or a program's registration form) in a
 * dialog. Any link with `data-zeffy="<id>"` opens the dialog with that `id`;
 * without JavaScript, or with a modified click, the link opens the form on
 * Zeffy's site. The form loads when its dialog first opens. Without a form,
 * the dialog says the registration form is a work in progress.
 */
import Icon from './Icon.astro';
import { site, type ZeffyForm } from '../site.config';

interface Props {
  id: string;
  /** The dialog's heading, e.g. "Donate to Sabeel Institute". */
  title: string;
  /** The form's accessible name, e.g. "Donation form". */
  label: string;
  /** Left out while a program's form is not ready. */
  form?: ZeffyForm;
}

const { id, title, label, form } = Astro.props;
---

<dialog
  id={id}
  aria-labelledby={`${id}-title`}
  data-zeffy-dialog
  class:list={[
    'm-auto w-[calc(100%-2rem)] max-w-xl flex-col overflow-hidden rounded-card bg-surface p-0 shadow-card backdrop:bg-ink/60 backdrop:backdrop-blur-sm open:flex',
    form && 'h-[min(52rem,calc(100dvh-2rem))] max-sm:h-dvh max-sm:max-h-none max-sm:w-full max-sm:max-w-none max-sm:rounded-none',
  ]}
>
  <div class="flex shrink-0 items-center justify-between gap-4 border-b border-border py-2 pr-2 pl-6">
    <h2 id={`${id}-title`} class="text-lg font-semibold text-ink">{title}</h2>
    <button
      type="button"
      data-zeffy-close
      class="flex size-11 shrink-0 items-center justify-center rounded-full text-ink hover:bg-inset"
    >
      <Icon name="x" class="size-5" label="Close" />
    </button>
  </div>
  {
    form ? (
      <iframe title={label} data-src={form.embed} allow="payment" class="min-h-0 w-full grow" />
    ) : (
      <div class="px-6 py-10 text-center sm:px-10">
        <p class="font-display text-[1.75rem] leading-tight font-bold text-raspberry">The registration form is a work in progress.</p>
        <p class="mt-3 text-ink-soft">
          Please check back soon. Questions? Email{' '}
          <a href={`mailto:${site.email}`} class="font-medium text-raspberry underline decoration-gold underline-offset-4">{site.email}</a>.
        </p>
      </div>
    )
  }
</dialog>

<script>
  document.addEventListener('click', (e) => {
    const trigger = (e.target as Element).closest<HTMLAnchorElement>('a[data-zeffy]');
    if (!trigger || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    const dialog = document.getElementById(trigger.dataset.zeffy!) as HTMLDialogElement;
    const form = dialog.querySelector('iframe');
    if (form) form.src ||= form.dataset.src!;
    dialog.showModal();
  });
  for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog[data-zeffy-dialog]')) {
    dialog.querySelector('[data-zeffy-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
