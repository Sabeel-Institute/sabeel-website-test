---
/**
 * A Zeffy form (the donation form, or a program's payment form) in a dialog.
 * Any link with `data-zeffy="<id>"` opens the dialog with that `id`; without
 * JavaScript, or with a modified click, the link opens the form on Zeffy's
 * site. The form loads when its dialog first opens.
 */
import Icon from './Icon.astro';
import type { ZeffyForm } from '../site.config';

interface Props {
  id: string;
  /** The dialog's heading, e.g. "Donate to Sabeel Institute". */
  title: string;
  /** The form's accessible name, e.g. "Donation form". */
  label: string;
  form: ZeffyForm;
}

const { id, title, label, form } = Astro.props;
---

<dialog
  id={id}
  aria-labelledby={`${id}-title`}
  data-zeffy-dialog
  class="m-auto h-[min(52rem,calc(100dvh-2rem))] w-[calc(100%-2rem)] max-w-xl flex-col overflow-hidden rounded-card bg-surface p-0 shadow-card backdrop:bg-ink/60 backdrop:backdrop-blur-sm open:flex max-sm:h-dvh max-sm:max-h-none max-sm:w-full max-sm:max-w-none max-sm:rounded-none"
>
  <div class="flex shrink-0 items-center justify-between gap-4 border-b border-border py-2 pr-2 pl-6">
    <h2 id={`${id}-title`} class="text-lg font-semibold text-ink">{title}</h2>
    <button
      type="button"
      data-zeffy-close
      class="flex size-11 shrink-0 items-center justify-center rounded-full text-ink hover:bg-inset"
    >
      <Icon name="x" class="size-5" label="Close" />
    </button>
  </div>
  <iframe title={label} data-src={form.embed} allow="payment" class="min-h-0 w-full grow"></iframe>
</dialog>

<script>
  document.addEventListener('click', (e) => {
    const trigger = (e.target as Element).closest<HTMLAnchorElement>('a[data-zeffy]');
    if (!trigger || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    const dialog = document.getElementById(trigger.dataset.zeffy!) as HTMLDialogElement;
    const form = dialog.querySelector('iframe')!;
    form.src ||= form.dataset.src!;
    dialog.showModal();
  });
  for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog[data-zeffy-dialog]')) {
    dialog.querySelector('[data-zeffy-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
