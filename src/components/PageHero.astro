---
/**
 * Interior page header from the remake's About page: eyebrow, serif title with
 * gold dividers, intro text on the left; still-life image on the right.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Divider from './Divider.astro';
import stillLife from '../assets/images/still-life-quran.jpg';
import sprig from '../assets/decor/sprig-sage-tall.png';

interface Props {
  title: string;
  eyebrow?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  eyebrow = 'Knowledge. Faith. Sisterhood.',
  image = stillLife,
  imageAlt = '',
} = Astro.props;
---

<section class="relative overflow-hidden bg-canvas">
  <Image
    src={sprig}
    alt=""
    width={120}
    class="pointer-events-none absolute top-24 -left-12 hidden w-[90px] -rotate-12 opacity-70 lg:block"
  />
  <div class="container-page grid items-center gap-8 py-10 md:grid-cols-[1.1fr_1fr] md:py-0">
    <div class="md:py-16 lg:py-20">
      <p class="eyebrow">{eyebrow}</p>
      <Divider width="sm" class="mt-3" />
      <h1 class="display-xl mt-4">{title}</h1>
      <Divider class="mt-5" />
      <div class="mt-7 max-w-[34rem] text-[17px] leading-[1.75] text-ink-soft">
        <slot />
      </div>
    </div>
    <div class="relative -mx-4 h-64 sm:-mx-6 md:mx-0 md:h-full md:min-h-[400px] lg:-mr-12">
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 720, 1000]}
        sizes="(min-width: 768px) 50vw, 100vw"
        class="absolute inset-0 size-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-y-0 left-0 hidden w-24 bg-linear-to-r from-canvas to-transparent md:block"></div>
    </div>
  </div>
</section>
