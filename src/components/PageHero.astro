---
/**
 * Page opening: eyebrow, serif title, lead text, and actions on the left; a
 * photo slot (or custom media) on the right.
 */
import Divider from './Divider.astro';
import Photo from './Photo.astro';
import type { IconName } from './Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  /** Photo slot name; see Photo.astro. */
  photo?: string;
  photoAlt?: string;
  photoIcon?: IconName;
  /** Use the larger home-page title size. */
  large?: boolean;
}

const { eyebrow, title, photo, photoAlt = '', photoIcon, large = false } = Astro.props;
---

<section class="relative overflow-hidden border-b border-border bg-linear-to-br from-surface via-canvas to-canvas">
  <div class="container-page grid items-center gap-10 py-12 md:grid-cols-[1.05fr_1fr] md:gap-12 md:py-16 lg:py-20">
    <div>
      <p class="eyebrow text-base font-bold tracking-[0.08em] text-gold-text uppercase md:text-lg">{eyebrow}</p>
      <Divider width="sm" class="mt-3" />
      <h1 class:list={['mt-5', large ? 'display-xl' : 'display-lg lg:text-[3.1rem]']}>{title}</h1>
      <div class="mt-6 max-w-[36rem] text-base leading-[1.8] text-ink-soft md:text-[17px] [&_p+p]:mt-4">
        <slot />
      </div>
      {
        Astro.slots.has('actions') && (
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <slot name="actions" />
          </div>
        )
      }
    </div>
    <div>
      {
        Astro.slots.has('media') ? (
          <slot name="media" />
        ) : (
          photo && (
            <Photo
              slot={photo}
              alt={photoAlt}
              icon={photoIcon}
              class="aspect-[4/3] shadow-card"
              sizes="(min-width: 768px) 48vw, 100vw"
              eager
            />
          )
        )
      }
    </div>
  </div>
</section>
