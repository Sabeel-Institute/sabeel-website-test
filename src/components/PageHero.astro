---
/**
 * Page opening, laid out like the first page of an illuminated manuscript: a
 * ruled frame around the section, a headpiece over the title, and the photo
 * (or custom media) set in an arch on the right with a sunburst behind it.
 */
import Divider from './Divider.astro';
import Photo from './Photo.astro';
import Lattice from './illumination/Lattice.astro';
import Frame from './illumination/Frame.astro';
import Headpiece from './illumination/Headpiece.astro';
import Shamsa from './illumination/Shamsa.astro';
import type { IconName } from './Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  /** Photo slot name; see Photo.astro. */
  photo?: string;
  photoAlt?: string;
  photoIcon?: IconName;
  /** Use the larger home-page title size. */
  large?: boolean;
}

const { eyebrow, title, photo, photoAlt = '', photoIcon, large = false } = Astro.props;
const hasMedia = Astro.slots.has('media') || Boolean(photo);
---

<section class="relative overflow-hidden border-b border-border bg-linear-to-br from-surface via-canvas to-canvas">
  <Lattice class="text-gold opacity-[0.09]" fade />
  {
    !hasMedia && (
      <Shamsa class="absolute top-1/2 right-0 hidden w-[36rem] translate-x-1/3 -translate-y-1/2 text-gold opacity-[0.12] md:block" />
    )
  }
  <Frame />
  <div class:list={['container-page relative py-14 md:py-20 lg:py-24', hasMedia && 'grid items-center gap-12 md:grid-cols-[1.05fr_1fr] md:gap-12']}>
    <div>
      <Headpiece class="mb-7 w-full max-w-[30rem] text-gold" />
      <p class="eyebrow">{eyebrow}</p>
      <h1 class:list={['mt-5', large ? 'display-xl' : 'display-lg lg:text-[3.1rem]']}>{title}</h1>
      <Divider width="sm" class="mt-5" />
      <div class="mt-6 max-w-[36rem] text-base leading-[1.8] text-ink-soft md:text-[17px] [&_p+p]:mt-4">
        <slot />
      </div>
      {
        Astro.slots.has('actions') && (
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <slot name="actions" />
          </div>
        )
      }
    </div>
    {
      hasMedia && (
        <div class="relative">
          <Shamsa class="absolute top-1/2 left-1/2 w-[125%] max-w-none -translate-x-1/2 -translate-y-1/2 text-gold opacity-[0.16]" />
          <div class="relative">
            {Astro.slots.has('media') ? (
              <slot name="media" />
            ) : (
              <Photo
                slot={photo}
                alt={photoAlt}
                icon={photoIcon}
                shape="arch"
                class="mx-auto aspect-[5/6] w-full max-w-[26rem]"
                sizes="(min-width: 768px) 26rem, 100vw"
                eager
              />
            )}
          </div>
        </div>
      )
    }
  </div>
</section>
