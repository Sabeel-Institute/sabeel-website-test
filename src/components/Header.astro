---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import Icon from './Icon.astro';
import { mainNav } from '../site.config';

const nav = mainNav;
const path = Astro.url.pathname;
const isActive = (item: (typeof nav)[number]) =>
  [item.href, ...(item.match ?? [])].some((prefix) => path.startsWith(prefix));
---

<header class="relative z-40 bg-canvas">
  <div class="container-page flex h-20 items-center justify-between gap-3 sm:gap-6 lg:h-24">
    <a href="/" class="shrink-0" aria-label="Sabeel Institute home">
      <Image
        src={logo}
        alt="Sabeel Institute"
        height={84}
        class="h-[68px] w-auto lg:h-[84px]"
        loading="eager"
        layout="fixed"
      />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-2 xl:gap-4">
        {
          nav.map((item, i) => (
            <li class:list={[item.menu && 'relative flex items-center']} data-dropdown={item.menu && ''}>
              <a
                href={item.href}
                aria-current={isActive(item) ? 'page' : undefined}
                class="relative rounded px-2 py-1.5 text-base text-ink transition-colors hover:text-raspberry aria-[current=page]:text-raspberry xl:px-3 xl:text-[17px]"
              >
                {item.label}
                <span
                  aria-hidden="true"
                  class:list={[
                    'absolute inset-x-2 -bottom-1 h-px bg-gold transition-opacity',
                    isActive(item) ? 'opacity-100' : 'opacity-0',
                  ]}
                />
              </a>
              {item.menu && (
                <>
                  <button
                    type="button"
                    aria-expanded="false"
                    aria-controls={`nav-menu-${i}`}
                    class="peer -ml-2 inline-flex h-11 w-7 items-center justify-center rounded text-ink transition-colors hover:text-raspberry aria-expanded:text-raspberry aria-expanded:*:rotate-180 xl:-ml-3"
                  >
                    <Icon name="chevron-down" class="size-4 transition-transform" label={`${item.label} menu`} />
                  </button>
                  <div id={`nav-menu-${i}`} class="absolute top-full -left-2 hidden pt-1 peer-aria-expanded:block">
                    <ul class="min-w-60 rounded-card border border-gold/60 bg-surface p-2 shadow-card">
                      {item.menu.map((link) => (
                        <li>
                          <a
                            href={link.href}
                            aria-current={path === link.href ? 'page' : undefined}
                            class="flex min-h-11 items-center rounded-lg px-3 text-base text-ink transition-colors hover:bg-canvas hover:text-raspberry aria-[current=page]:font-semibold aria-[current=page]:text-raspberry"
                          >
                            {link.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/support/" class="btn btn-primary px-4 text-sm whitespace-nowrap sm:px-5 sm:text-base lg:px-6 lg:text-[16px]">
        Support Our Work
      </a>
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-lg text-ink hover:bg-inset lg:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-menu-toggle
      >
        <span data-menu-open><Icon name="menu" class="size-6" label="Open menu" /></span>
        <span data-menu-close hidden><Icon name="x" class="size-6" label="Close menu" /></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Main"
    hidden
    class="absolute inset-x-0 top-full border-t border-border bg-surface shadow-card lg:hidden"
  >
    <ul class="container-page flex flex-col py-3">
      {
        nav.map((item, i) => (
          <li class="border-b border-border/70">
            <div class="flex items-center">
              <a
                href={item.href}
                aria-current={isActive(item) ? 'page' : undefined}
                class="flex min-h-12 flex-1 items-center text-lg text-ink aria-[current=page]:font-semibold aria-[current=page]:text-raspberry"
              >
                {item.label}
              </a>
              {item.menu && (
                <button
                  type="button"
                  aria-expanded="false"
                  aria-controls={`mobile-nav-menu-${i}`}
                  class="-mr-3 inline-flex size-12 items-center justify-center text-ink aria-expanded:*:rotate-180"
                  data-submenu-toggle
                >
                  <Icon name="chevron-down" class="size-5 transition-transform" label={`${item.label} menu`} />
                </button>
              )}
            </div>
            {item.menu && (
              <ul id={`mobile-nav-menu-${i}`} hidden class="mb-3 ml-1 border-l border-gold/60 pl-4">
                {item.menu.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={path === link.href ? 'page' : undefined}
                      class="flex min-h-11 items-center text-base text-ink aria-[current=page]:font-semibold aria-[current=page]:text-raspberry"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-nav');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector<HTMLElement>('[data-menu-open]')!.hidden = open;
      toggle.querySelector<HTMLElement>('[data-menu-close]')!.hidden = !open;
    };
    toggle.addEventListener('click', () => setOpen(menu.hasAttribute('hidden')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  // In the phone menu, an item's button shows or hides the links under it.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-submenu-toggle]')) {
    const links = document.getElementById(button.getAttribute('aria-controls')!)!;
    button.addEventListener('click', () => {
      links.hidden = !links.hidden;
      button.setAttribute('aria-expanded', String(!links.hidden));
    });
  }

  // On wide screens, a mouse opens an item's drop-down menu while over it. The
  // item's button opens it for keyboards and touch screens and keeps it open
  // until the button is pressed again, Escape, or a click or focus elsewhere.
  for (const item of document.querySelectorAll<HTMLElement>('[data-dropdown]')) {
    const button = item.querySelector('button')!;
    const isOpen = () => button.getAttribute('aria-expanded') === 'true';
    let pinned = false;
    let timer: number | undefined;
    const setOpen = (open: boolean) => {
      clearTimeout(timer);
      pinned &&= open;
      button.setAttribute('aria-expanded', String(open));
    };
    const setOpenAfter = (open: boolean, ms: number) => {
      clearTimeout(timer);
      timer = window.setTimeout(() => setOpen(open), ms);
    };
    item.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') setOpenAfter(true, 100);
    });
    item.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse' && !pinned) setOpenAfter(false, 250);
    });
    button.addEventListener('click', () => {
      const open = !pinned;
      setOpen(open);
      pinned = open;
    });
    item.addEventListener('focusout', (e) => {
      const to = e.relatedTarget as Node | null;
      if (to && !item.contains(to)) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && !item.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !isOpen()) return;
      const hadFocus = item.contains(document.activeElement);
      setOpen(false);
      if (hadFocus) button.focus();
    });
  }
</script>
