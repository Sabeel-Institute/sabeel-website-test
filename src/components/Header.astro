---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import Icon from './Icon.astro';
import { mainNav } from '../site.config';

const nav = mainNav;
const path = Astro.url.pathname;
const isActive = (item: (typeof nav)[number]) =>
  [item.href, ...(item.match ?? [])].some((prefix) => path.startsWith(prefix));
---

<header class="relative z-40 bg-canvas">
  <div class="container-page flex h-20 items-center justify-between gap-6 lg:h-24">
    <a href="/" class="shrink-0" aria-label="Sabeel Institute home">
      <Image
        src={logo}
        alt="Sabeel Institute"
        width={150}
        class="h-auto w-[118px] lg:w-[140px]"
        loading="eager"
        layout="fixed"
      />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-2 xl:gap-4">
        {
          nav.map((item) => (
            <li class="relative group">
              <a
                href={item.href}
                aria-current={isActive(item) ? 'page' : undefined}
                aria-haspopup={item.children ? 'true' : undefined}
                class="relative inline-flex items-center gap-1.5 rounded px-2 py-1.5 text-base text-ink transition-colors hover:text-raspberry aria-[current=page]:text-raspberry xl:px-3 xl:text-[17px]"
              >
                {item.label}
                {item.children && (
                  <Icon
                    name="chevron-down"
                    class="size-4 text-ink-soft transition-transform group-hover:rotate-180 group-focus-within:rotate-180"
                  />
                )}
                <span
                  aria-hidden="true"
                  class:list={[
                    'absolute inset-x-2 -bottom-1 h-px bg-gold transition-opacity',
                    isActive(item) ? 'opacity-100' : 'opacity-0',
                  ]}
                />
              </a>
              {item.children && (
                <ul
                  class="absolute left-0 top-full hidden w-52 pt-2 group-hover:block group-focus-within:block z-50"
                >
                  <li class="rounded-card border border-border bg-surface p-1.5 shadow-card">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        aria-current={path === child.href ? 'page' : undefined}
                        class="block rounded-md px-3 py-2 text-15px text-ink transition-colors hover:bg-canvas hover:text-raspberry aria-[current=page]:font-semibold aria-[current=page]:text-raspberry"
                      >
                        {child.label}
                      </a>
                    ))}
                  </li>
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/support/" class="btn btn-primary hidden px-5 text-base sm:inline-flex lg:px-6 lg:text-[16px]">
        Support Our Work
      </a>
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-lg text-ink hover:bg-inset lg:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-menu-toggle
      >
        <span data-menu-open><Icon name="menu" class="size-6" label="Open menu" /></span>
        <span data-menu-close hidden><Icon name="x" class="size-6" label="Close menu" /></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Main"
    hidden
    class="absolute inset-x-0 top-full border-t border-border bg-surface shadow-card lg:hidden"
  >
    <ul class="container-page flex flex-col py-3">
      {
        nav.map((item) => (
          <li>
            {item.children ? (
              <div class="border-b border-border/70 py-2.5">
                <a
                  href={item.href}
                  aria-current={isActive(item) ? 'page' : undefined}
                  class="flex min-h-9 items-center text-lg text-ink aria-[current=page]:font-semibold aria-[current=page]:text-raspberry"
                >
                  {item.label}
                </a>
                <ul class="ml-2 mt-1.5 space-y-1 border-l-2 border-gold/40 pl-3">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        aria-current={path === child.href ? 'page' : undefined}
                        class="flex min-h-9 items-center text-base text-ink-soft hover:text-raspberry aria-[current=page]:font-semibold aria-[current=page]:text-raspberry"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <a
                href={item.href}
                aria-current={isActive(item) ? 'page' : undefined}
                class="flex min-h-12 items-center border-b border-border/70 text-lg text-ink aria-[current=page]:font-semibold aria-[current=page]:text-raspberry"
              >
                {item.label}
              </a>
            )}
          </li>
        ))
      }
      <li class="pt-4 pb-2">
        <a href="/support/" class="btn btn-primary w-full text-base">Support Our Work</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-nav');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector<HTMLElement>('[data-menu-open]')!.hidden = open;
      toggle.querySelector<HTMLElement>('[data-menu-close]')!.hidden = !open;
    };
    toggle.addEventListener('click', () => setOpen(menu.hasAttribute('hidden')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
