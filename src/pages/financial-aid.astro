---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';

const steps = [
  { icon: 'book-open', title: 'Find your program', text: 'Choose the program you would like to join.', href: '/programs/', link: 'View programs' },
  { icon: 'hand-heart', title: 'Apply for aid', text: 'Complete the short financial aid form.', href: site.financialAidFormUrl, link: 'Open the form' },
  { icon: 'mail', title: 'Questions?', text: `Email ${site.email} and we will be glad to help.`, href: `mailto:${site.email}`, link: 'Email us' },
] as const;
---

<BaseLayout
  title="Financial Aid"
  description="Finances should never be a barrier to learning. Apply for financial aid for Sabeel Institute programs."
>
  <PageHero eyebrow="Financial aid" title="Finances should never be a barrier to learning.">
    <p>If you or your family are facing financial hardship, you may be eligible for financial aid.</p>
    <a slot="actions" href={site.financialAidFormUrl} class="btn btn-primary px-7 text-base" target="_blank" rel="noopener">
      Apply for Financial Aid <Icon name="external" class="size-4" />
    </a>
    <ol slot="media" class="grid gap-4">
      {
        steps.map((s, i) => (
          <li class="card-illuminated flex gap-5 rounded-card p-6">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-canvas text-gold-text">
              <Icon name={s.icon} class="size-6" />
            </span>
            <span>
              <span class="block text-sm font-bold tracking-wide text-gold-text uppercase">Step {i + 1}</span>
              <span class="block text-lg font-semibold text-ink">{s.title}</span>
              <span class="block text-ink-soft">{s.text}</span>
              <a href={s.href} class="link-arrow mt-1 text-[15px]">
                {s.link} <Icon name="arrow-right" class="size-4" />
              </a>
            </span>
          </li>
        ))
      }
    </ol>
  </PageHero>

  <CtaBand title="Help keep learning open.">
    <p>Gifts to Sabeel Institute help us continue our work today and support our goals for the future.</p>
    <a slot="actions" href="/support/" class="btn btn-primary px-7 text-base">Support Our Work</a>
  </CtaBand>
</BaseLayout>
