---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CurrentPrograms from '../../components/CurrentPrograms.astro';
import AreaCards from '../../components/AreaCards.astro';
import Collage from '../../components/Collage.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { areas } from '../../site.config';
import {
  STATUS_LABEL,
  getClosedPrograms,
  getCurrentPrograms,
  getUpcomingPrograms,
  programHref,
  rhythmLabel,
  startLabel,
  type Program,
} from '../../lib/content';

const current = await getCurrentPrograms();
/** Programs people cannot join now, each listed with what to know about it. */
const notJoinable = [
  {
    label: STATUS_LABEL.upcoming,
    programs: await getUpcomingPrograms(),
    detail: (p: Program) => [rhythmLabel(p), `Starts ${startLabel(p)}`].filter(Boolean).join(' · '),
  },
  { label: STATUS_LABEL.closed, programs: await getClosedPrograms(), detail: (p: Program) => rhythmLabel(p) },
].filter((l) => l.programs.length > 0);
---

<BaseLayout
  title="Programs"
  description="Programs for women, teens, and children at Sabeel Institute: what is open for registration now, our three program areas, and past programs."
>
  <PageHero eyebrow="Programs" title="Find your place to learn at Sabeel.">
    <p>
      Explore programs now accepting registration, learn about our program areas, or browse previously offered
      programs.
    </p>
    <Collage
      slot="media"
      tiles={[
        { slot: 'programs-women', label: 'Women', alt: 'Women studying together at Sabeel', icon: 'book-open' },
        { slot: 'programs-teens', label: 'Teens', alt: 'Teen boys in a Sabeel class', icon: 'users' },
        { slot: 'programs-children', label: 'Children', alt: 'Children learning at Sabeel', icon: 'leaf' },
      ]}
    />
  </PageHero>

  <!-- Now enrolling -->
  <section class="py-20 lg:py-28" aria-labelledby="enrolling-heading">
    <div class="container-page">
      <SectionHeading number="01" eyebrow="Now enrolling" title="Open for registration" id="enrolling-heading">
        <p>Grouped by where they meet: online, on site in Houston, or both. Registration links, dates, and fees are on each program’s page.</p>
      </SectionHeading>
      {
        current.length > 0 ? (
          <CurrentPrograms programs={current} />
        ) : (
          <p class="card-illuminated rise mt-10 rounded-card p-7 text-ink-soft">
            No programs are open for registration right now. Join the interest list to hear when the next ones open.
          </p>
        )
      }
      {
        notJoinable.map((l) => (
          <div class="card-illuminated rise mt-12 rounded-card p-7">
            <p class="label">{l.label}</p>
            <ul class="mt-3 divide-y divide-border">
              {l.programs.map((p) => (
                <li class="flex flex-wrap items-center justify-between gap-3 py-3">
                  <span>
                    <span class="font-display text-[1.45rem] font-semibold text-raspberry">{p.data.title}</span>
                    <span class="text-ink-soft">
                      {areas[p.data.area].label !== p.data.title && ` · ${areas[p.data.area].label}`} · {l.detail(p)}
                    </span>
                  </span>
                  <a href={programHref(p)} class="link-arrow text-[15px]">
                    Learn more <Icon name="arrow-right" class="size-4" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Program areas -->
  <section class="border-t border-border py-20 lg:py-28" aria-labelledby="areas-heading">
    <div class="container-page">
      <SectionHeading number="02" eyebrow="How our programs are organized" title="Explore our program areas." id="areas-heading" />
      <div class="mt-14">
        <AreaCards />
      </div>
    </div>
  </section>

  <!-- Interest list -->
  <section class="border-t border-border py-16 lg:py-20">
    <div class="container-page grid items-center gap-6 md:grid-cols-[1.1fr_1fr] md:gap-12">
      <div>
        <h2 class="display-md">Not seeing the right program?</h2>
        <p class="mt-3 text-ink-soft">Join the interest list to hear about upcoming programs for your learner group.</p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href="/contact/?inquiry=interest-list" data-interest class="btn btn-primary px-6 text-base">Join the Interest List</a>
        <a href="/contact/?inquiry=program" class="btn btn-outline px-6 text-base">Ask About a Program</a>
      </div>
    </div>
  </section>

  <CtaBand title="Explore Sabeel’s past programs." eyebrow="Program archive">
    <p>Browse previous programs by area and year to see what Sabeel has offered.</p>
    <a slot="actions" href="/past-programs/" class="btn btn-primary px-7 text-base">Browse the Program Archive</a>
  </CtaBand>
</BaseLayout>
