---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
---

<BaseLayout title="Blog" description="Reflections, reminders, and news from Sabeel Institute.">
  <PageHero title="Our Blog">
    <p>Reflections, reminders, and news from Sabeel Institute.</p>
  </PageHero>

  <section class="py-14 md:py-16">
    <div class="container-page">
      {
        posts.length === 0 ? (
          <p class="rounded-card border border-border bg-surface p-7 text-center text-ink-soft">
            Our first articles are on the way. Subscribe below to hear when they are published.
          </p>
        ) : (
          <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <li>
                <article class="group relative flex h-full flex-col overflow-hidden rounded-card bg-surface shadow-card">
                  {post.data.cover && (
                    <Image src={post.data.cover} alt="" widths={[400, 640]} sizes="(min-width: 1024px) 400px, 100vw" class="aspect-[3/2] w-full object-cover" />
                  )}
                  <div class="flex flex-1 flex-col p-6">
                    <p class="text-sm text-ink-soft">
                      <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
                    </p>
                    <h2 class="mt-2 font-display text-2xl leading-tight font-bold text-raspberry">
                      <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0 after:content-['']">
                        {post.data.title}
                      </a>
                    </h2>
                    <p class="mt-3 text-ink-soft">{post.data.summary}</p>
                    <p class="mt-auto flex items-center gap-2 pt-5 font-display text-lg font-bold text-raspberry">
                      Read More <Icon name="arrow-right" class="size-5" />
                    </p>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
