---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import SabeelDifference from '../components/SabeelDifference.astro';
---

<BaseLayout
  title="About"
  description="Since 2009, Sabeel has brought women together for structured, in-person Islamic learning in Houston."
>
  <PageHero
    eyebrow="Who we are"
    title="A women-led home for Islamic learning in Houston."
    photo="about-hero"
    photoAlt="Women studying at low tables in a Sabeel class"
    photoIcon="users"
  >
    <p>
      Since 2009, Sabeel has brought women together for structured, in-person Islamic learning in Houston. Today, its
      programs serve adult women, university students, teens, and children.
    </p>
  </PageHero>

  <!-- Mission and vision -->
  <section class="py-14 md:py-20">
    <div class="container-page grid gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <p class="eyebrow text-base font-bold tracking-[0.08em] text-gold-text uppercase md:text-lg">Mission</p>
        <h2 class="display-lg mt-2 sm:text-[2.6rem]">Sound knowledge for faithful lives.</h2>
        <Divider class="mt-4" />
        <p class="mt-4 text-base leading-[1.8] text-ink-soft md:text-[17px]">
          Sabeel equips women and families through structured, in-person study rooted in the Qur’an, Sunnah, and
          scholarly tradition — nurturing sound knowledge, faithful practice, and service.
        </p>
      </div>
      <div>
        <p class="eyebrow text-base font-bold tracking-[0.08em] text-gold-text uppercase md:text-lg">Vision</p>
        <h2 class="display-lg mt-2 sm:text-[2.6rem]">Knowledge that multiplies into service.</h2>
        <Divider class="mt-4" />
        <p class="mt-4 text-base leading-[1.8] text-ink-soft md:text-[17px]">
          We envision generations of learners whose knowledge strengthens their homes, masjids, and communities.
        </p>
      </div>
    </div>
  </section>

  <!-- Our story -->
  <section class="border-t border-border py-14 md:py-20" aria-labelledby="story-heading">
    <div class="container-page grid items-center gap-10 md:grid-cols-2 md:gap-16">
      <Photo slot="about-story" alt="Sabeel’s community praying together in a park beside a Sabeel tent" icon="book-open" class="aspect-[5/4] shadow-card" />
      <div>
        <p class="eyebrow text-base font-bold tracking-[0.08em] text-gold-text uppercase md:text-lg">Our story</p>
        <h2 id="story-heading" class="display-lg mt-2 sm:text-[2.6rem]">Built by women, growing across generations.</h2>
        <Divider class="mt-4" />
        <p class="mt-4 text-base leading-[1.8] text-ink-soft md:text-[17px]">
          Since 2009, Sabeel has grown from one teacher offering classes to university students and adult women in
          masjids across southwest Houston into a teaching faculty of seven ‘Alimaat. Graduates of Sabeel’s own
          programs continue their studies and now serve in teaching, administration, and program support. What began
          with adult classes now includes learning for children and teens — forming an intergenerational community
          rooted in knowledge, suhbah, and service.
        </p>
        <a href="/teachers-and-team/#teachers" class="link-arrow mt-6 text-lg">Meet Our Teachers <Icon name="arrow-right" class="size-5" /></a>
      </div>
    </div>
  </section>

  <SabeelDifference />
</BaseLayout>
