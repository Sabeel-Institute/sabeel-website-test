---
/**
 * Bespoke page for the Hikam Foundations program area. The next intake's
 * facts (start, schedule, format, audience, registration link) come from
 * src/content/programs/hikam-foundations-2026, which points here with `page:`.
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import FactsBar from '../components/FactsBar.astro';
import { site } from '../site.config';
import { STATUS_LABEL, getCurrentPrograms, programHref, startLabel } from '../lib/content';

const intake = (await getEntry('programs', 'hikam-foundations-2026'))!;
const d = intake.data;
const start = startLabel(intake);
const formatLabel = d.format;
const applyUrl = d.status === 'open' || d.status === 'ongoing' ? d.registerUrl : undefined;
const testimonials = (await getCollection('testimonials')).filter((t) => t.data.program === 'Certification Program');
const prep = (await getCurrentPrograms()).find((p) => p.data.title.startsWith('Quran Immersion'));
const askHref = `/contact/?inquiry=program&program=${encodeURIComponent('Hikam Foundations')}`;

const highlights = [
  { icon: 'calendar', title: d.schedule ?? 'Weekly classes', text: 'Consistent weekly learning designed to fit your schedule.' },
  { icon: 'users', title: 'For Adult Women', text: 'Including university students and busy moms.' },
  { icon: 'laptop', title: formatLabel ?? 'In Person', text: 'Learn in Houston or live online, with the same teachers.' },
] as const;

const subjects = [
  { icon: 'book-open', title: 'Qur’an and tafsir' },
  { icon: 'graduation-cap', title: 'Hadith · fiqh · seerah' },
  { icon: 'sparkle', title: 'Belief and proofs of Islam' },
  { icon: 'languages', title: 'Arabic' },
  { icon: 'heart', title: 'Purification of the heart' },
] as const;

const experience = [
  'Regular classes and guided reading',
  'Assessment and clear expectations',
  'Mentorship and suhbah',
  'Opportunities to serve',
  'A defined next step after completion',
];

const faqs = [
  {
    q: 'Who is it for?',
    a: 'Adult women who want a structured grounding in the Islamic sciences, including university students and mothers balancing full lives.',
  },
  {
    q: 'What if I miss a class?',
    a: 'Attendance matters: in the 2024 cohort, students needed 85% attendance to continue. If you know you will miss classes, ask us before applying.',
  },
  { q: 'Is Arabic required?', a: 'Arabic is one of the subjects taught in the program.' },
  {
    q: 'Is it a certificate?',
    a: 'Students who complete the program receive a certificate from Sabeel Institute. It is not an accredited academic degree.',
  },
  { q: 'Can I study online?', a: 'Yes. Classes are offered in person in Houston and live online.' },
];
---

<BaseLayout title="Hikam Foundations" description={d.summary}>
  <PageHero
    eyebrow="Sustained study for adult women"
    title="Hikam Foundations"
    photo="hikam-hero"
    photoAlt="A copy of the Qur’an beside a vase of olive branches"
    photoIcon="graduation-cap"
  >
    <p>{d.summary}</p>
    <p class="inline-flex items-center gap-2 rounded-full border border-gold bg-surface px-4 py-2 text-[15px] font-medium text-ink">
      <Icon name="sparkle" class="size-4 text-gold" />
      Next intake: {start} · {STATUS_LABEL[d.status]}
    </p>
    <Fragment slot="actions">
      <a href="#next-intake" class="btn btn-primary px-7 text-base">View Next Intake</a>
      {
        site.hikamOverviewPdf && (
          <a href={site.hikamOverviewPdf} class="btn btn-outline px-6 text-base" download>
            Download Program Overview
          </a>
        )
      }
    </Fragment>
  </PageHero>

  <section class="py-8 md:py-10">
    <div class="container-page">
      <FactsBar
        facts={[
          { label: 'Length', value: d.duration },
          { label: 'Audience', value: d.audience },
          { label: 'Format', value: formatLabel },
          { label: 'Next intake', value: start },
        ]}
      />
    </div>
  </section>

  <!-- Certificate card -->
  <section class="pb-12 md:pb-16">
    <div class="container-page">
      <div class="relative rounded-sm border border-gold/80 bg-surface px-5 py-12 text-center sm:px-10 md:py-14">
        <Icon name="sparkle" class="absolute top-6 left-6 size-5 text-gold" />
        <Icon name="sparkle" class="absolute right-6 bottom-6 size-5 text-gold" />
        <p class="font-label text-[15px] font-bold tracking-[0.18em] text-gold-text uppercase">Sabeel Institute</p>
        <h2 class="mt-3 font-display text-5xl font-bold text-raspberry sm:text-6xl">Two-Year</h2>
        <Divider align="center" width="sm" class="mt-4" />
        <p class="mt-5 font-display text-2xl text-ink-soft sm:text-[1.7rem]">Certificate Program</p>
        <ul class="mt-10 grid gap-10 md:grid-cols-3 md:gap-0">
          {
            highlights.map((h, i) => (
              <li class:list={['px-4 md:px-8', i > 0 && 'md:border-l md:border-border-strong']}>
                <span class="mx-auto flex size-[74px] items-center justify-center rounded-full bg-raspberry text-on-raspberry">
                  <Icon name={h.icon} class="size-8" />
                </span>
                <h3 class="mt-4 font-display text-[1.7rem] leading-tight font-bold text-raspberry">{h.title}</h3>
                <p class="mt-2 text-[15px] text-ink-soft">{h.text}</p>
              </li>
            ))
          }
        </ul>
        <p class="mt-10 font-label text-sm font-bold tracking-[0.16em] text-gold-text uppercase">Small cohort learning</p>
      </div>
    </div>
  </section>

  <!-- What students study / experience -->
  <section class="bg-sage-mist py-14 md:py-16" aria-labelledby="study-heading">
    <div class="container-page">
      <SectionHeading eyebrow="What students study" title="Core Islamic sciences" id="study-heading" align="center" />
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          subjects.map((s) => (
            <li class="flex flex-col items-center rounded-card border-t-4 border-gold bg-surface px-4 py-6 text-center">
              <span class="flex size-12 items-center justify-center rounded-full bg-canvas text-gold-text">
                <Icon name={s.icon} class="size-6" />
              </span>
              <h3 class="mt-3 font-display text-[1.45rem] leading-tight font-bold text-raspberry">{s.title}</h3>
            </li>
          ))
        }
      </ul>
      <div class="mt-8 rounded-card bg-surface p-7 sm:p-9">
        <p class="eyebrow">What the experience includes</p>
        <h3 class="mt-1 font-display text-[1.9rem] font-bold text-raspberry">Study, reflection, and service</h3>
        <ul class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            experience.map((e) => (
              <li class="flex items-start gap-3 text-ink">
                <Icon name="check" class="mt-1 size-5 shrink-0 text-success" strokeWidth={2.25} />
                {e}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Mission band -->
  <section class="pt-14 md:pt-16">
    <div class="container-page">
      <div class="rounded-sm bg-raspberry px-6 py-12 text-center text-on-raspberry md:py-14">
        <h2 class="font-display text-4xl font-bold tracking-[0.08em] uppercase sm:text-5xl">Our Mission</h2>
        <p class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-display text-2xl tracking-[0.2em] uppercase sm:text-3xl">
          <span>Learn</span><span class="size-3.5 rotate-45 bg-gold" aria-hidden="true"></span><span>Reflect</span><span
            class="size-3.5 rotate-45 bg-gold"
            aria-hidden="true"></span><span>Serve</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Decision information -->
  <section class="py-14 md:py-16" aria-labelledby="decide-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Before you apply" title="What prospective students need to know" id="decide-heading" />
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <div class="rounded-card border border-gold/60 bg-surface p-7">
          <h3 class="text-xl font-semibold text-ink">Schedule &amp; workload</h3>
          <p class="mt-3 leading-[1.75] text-ink-soft">
            Classes meet {d.schedule ? `on ${d.schedule}` : 'weekly'}, in person in Houston and live online. Each course includes review quizzes and a final exam, alongside guided reading.
          </p>
        </div>
        <div class="rounded-card border border-gold/60 bg-surface p-7">
          <h3 class="text-xl font-semibold text-ink">Faculty &amp; qualifications</h3>
          <p class="mt-3 leading-[1.75] text-ink-soft">
            Taught by women who have completed an ‘Alimiyyah — a traditional, multi-year program of Islamic
            scholarship.
          </p>
          <a href="/teachers-and-team/#teachers" class="link-arrow mt-3 text-[15px]">
            Meet the teaching team <Icon name="arrow-right" class="size-4" />
          </a>
        </div>
        <div class="rounded-card border border-gold/60 bg-surface p-7">
          <h3 class="text-xl font-semibold text-ink">Completion &amp; progression</h3>
          <p class="mt-3 leading-[1.75] text-ink-soft">
            Students who complete both years receive a certificate from Sabeel Institute. It is not an accredited
            academic degree.
          </p>
        </div>
      </div>

      {
        testimonials.length > 0 && (
          <div class="mt-14">
            <SectionHeading eyebrow="In their words" title="From our certificate students" align="center" />
            <ul class="mt-10 grid gap-5 md:grid-cols-2">
              {testimonials.map((t) => (
                <li>
                  <figure class="h-full rounded-card border border-border bg-surface p-7">
                    <Icon name="quote" class="size-7 text-gold" />
                    <blockquote class="mt-3 font-display text-xl leading-snug text-ink">{t.data.quote}</blockquote>
                  </figure>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <!-- Next intake / applications -->
  <section id="next-intake" class="scroll-mt-6 border-y border-border bg-sage-mist py-14 md:py-16" aria-labelledby="apply-heading">
    <div class="container-page grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-14">
      <div>
        <p class="text-[15px] font-bold tracking-[0.04em] text-raspberry uppercase">Applications</p>
        <h2 id="apply-heading" class="font-display text-[2.3rem] leading-tight font-bold text-raspberry">Begin with a clear next step.</h2>
        <p class="mt-3 leading-[1.8] text-ink">
          {
            applyUrl
              ? 'Applications for the next intake are open.'
              : 'Applications for the next intake open soon. Join the interest list and we’ll tell you when they do.'
          }
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          {
            applyUrl ? (
              <a href={applyUrl} class="btn btn-primary px-7 text-base" target="_blank" rel="noopener">
                Apply Now <Icon name="external" class="size-4" />
              </a>
            ) : (
              <a href="/contact/?inquiry=interest-list" data-interest class="btn btn-primary px-7 text-base">
                Join the Interest List
              </a>
            )
          }
          <a href={askHref} class="btn btn-outline bg-surface/60 px-6 text-base">Ask a Question</a>
        </div>
      </div>
      <dl class="divide-y divide-border rounded-card bg-surface px-6 text-[15px]">
        {
          [
            { label: 'Who can apply', value: d.audience },
            { label: 'Next intake', value: start },
            { label: 'Schedule', value: d.schedule },
            { label: 'Fee', value: d.fee ?? 'Shared when applications open · financial aid available' },
            { label: 'Questions', value: site.email },
          ]
            .filter((r) => r.value)
            .map((r) => (
              <div class="grid grid-cols-[8.5rem_1fr] gap-3 py-3.5">
                <dt class="text-ink-soft">{r.label}</dt>
                <dd class="font-medium text-ink">
                  {r.label === 'Questions' ? (
                    <a href={`mailto:${site.email}`} class="text-raspberry underline decoration-gold underline-offset-4">{r.value}</a>
                  ) : r.label === 'Fee' && !d.fee ? (
                    <>
                      Shared when applications open ·{' '}
                      <a href="/financial-aid/" class="text-raspberry underline decoration-gold underline-offset-4">financial aid</a> available
                    </>
                  ) : (
                    r.value
                  )}
                </dd>
              </div>
            ))
        }
      </dl>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-14 md:py-16" aria-labelledby="faq-heading">
    <div class="container-page max-w-[52rem]">
      <SectionHeading title="Frequently asked questions" id="faq-heading" />
      <div class="mt-8 space-y-3">
        {
          faqs.map((f) => (
            <details class="group rounded-card border border-border/80 bg-surface px-5 py-1.5 transition-colors duration-200 hover:border-gold hover:bg-sage-wash/30">
              <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 py-2 text-lg font-semibold text-ink transition-colors group-hover:text-raspberry [&::-webkit-details-marker]:hidden">
                <span>{f.q}</span>
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-sage-wash text-gold-text transition-colors duration-200 group-hover:bg-raspberry group-hover:text-on-raspberry group-open:bg-raspberry group-open:text-on-raspberry">
                  <Icon name="chevron-down" class="size-5 transition-transform duration-200 group-open:rotate-180" />
                </span>
              </summary>
              <p class="pt-1 pb-4 leading-[1.8] text-ink-soft">
                {f.a}
                {f.q === 'Is Arabic required?' && prep && (
                  <>
                    {' '}For a head start,{' '}
                    <a href={programHref(prep)} class="text-raspberry underline decoration-gold underline-offset-4">
                      {prep.data.title}
                    </a>{' '}
                    introduces Arabic grammar step by step.
                  </>
                )}
              </p>
            </details>
          ))
        }
      </div>
      <a href="/past-programs/" class="link-arrow mt-8">
        See past cohorts in Past Programs <Icon name="arrow-right" class="size-5" />
      </a>
    </div>
  </section>
</BaseLayout>
