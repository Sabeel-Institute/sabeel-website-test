---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Divider from '../components/Divider.astro';
import Video from '../components/Video.astro';
import { areas, site } from '../site.config';
import { programYear } from '../lib/content';

const area = areas['hikam-foundations'];
// The next intake, listed under Coming soon on Programs; the announcement takes its year from it.
const intake = (await getEntry('programs', 'hikam-foundations-2027'))!;
// Fonts draw ﷺ small, so it is set larger to read at the size of the text around it.
const salawat = 'text-[1.35em] leading-none';
---

<BaseLayout title={area.label} description={area.description}>
  <PageHero eyebrow="Program area" title={area.label}>
    <p>
      Hikam Foundations is a part-time Islamic Studies program for women who wish to deepen their understanding of
      Islam, draw closer to Allah, and carry sacred learning into their everyday lives.
    </p>
    <p>
      Through the study of the Qur’an, Hadith, Islamic belief and practice, Arabic grammar, and the life of the
      Prophet <span class={salawat}>ﷺ</span>, students build a foundation for a lifetime of learning. Alongside these
      subjects, the program gives attention to the heart: nurturing sincerity, beautiful character, and love for Allah
      and His Messenger <span class={salawat}>ﷺ</span>.
    </p>
    <p>
      Companionship and service are part of this journey. Learning together offers women the opportunity to build
      meaningful bonds with their teachers and fellow students, while community service invites them to put what they
      learn into practice.
    </p>
    <p>
      Our hope is that students leave with greater confidence in their faith, a deeper connection to their worship, and
      the knowledge and care to serve their families and communities well.
    </p>
  </PageHero>

  <!-- Meet Aziza -->
  <section class="py-14 md:py-16" aria-labelledby="aziza-heading">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
      <div>
        <h2 id="aziza-heading" class="display-md sm:text-[2.35rem]">Meet Aziza, a Hikam graduate</h2>
        <p class="mt-2 font-label text-[15px] font-semibold tracking-[0.04em] text-gold-text sm:text-base">
          Age 16 · Continuing her studies at Sabeel
        </p>
        <Divider class="mt-4" />
        <p class="mt-6 font-display text-[1.55rem] leading-snug font-semibold text-raspberry sm:text-[1.7rem]">
          A beginning in sacred learning can become a cherished part of a woman’s life, and sometimes, something a
          mother and daughter share.
        </p>
        <div class="mt-5 space-y-4 text-base leading-[1.85] text-ink-soft md:text-[17px]">
          <p>
            Two years ago, Aziza Musabeh joined Hikam Foundations and Madinah Arabic alongside her mother. She graduated
            from Hikam among the top students in her class, and her journey at Sabeel continued. Now sixteen and in her
            third year of study, she is studying Intermediate Madinah Arabic and Fiqh.
          </p>
          <p>
            Beyond the classroom, Aziza has joined Summer Garden and Teen Sundays and contributes to our Youth Sacred
            Service Team by creating Instagram reels. Her adab, gentle presence, willingness to serve, and delicious
            chocolate chip cookies have earned her a special place in her teachers’ hearts.
          </p>
          <p>
            It is a joy to see her continue to grow in knowledge and become such a beloved part of the community in which
            she learns.
          </p>
        </div>
      </div>
      <div>
        <h3 class="font-display text-[1.7rem] leading-tight font-bold text-raspberry sm:text-[1.9rem]">
          Watch Aziza reflect on learning Arabic at Sabeel
        </h3>
        <p class="mt-3 leading-[1.8] text-ink-soft">
          In this video, Aziza reflects on studying Arabic at Sabeel and the joy of a closer connection to the Qur’an
          through understanding its language.
        </p>
        <div class="mt-6">
          <Video
            name="aziza-learning-arabic"
            title="Aziza on learning Arabic"
            play={{ x: 9.58, y: 84.2, size: 8.33 }}
            sizes="(min-width: 1320px) 612px, (min-width: 1024px) 45vw, calc(100vw - 3rem)"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Hikam 2027 -->
  <section class="border-t border-border bg-sage-mist py-14 md:py-20" aria-labelledby="next-heading">
    <div class="container-page">
      <div class="mx-auto max-w-[56rem] rounded-card border border-gold/60 border-t-4 border-t-gold bg-surface px-6 py-12 text-center shadow-card sm:px-12 md:py-16">
        <p class="eyebrow">Coming soon</p>
        <h2 id="next-heading" class="display-xl mt-2">Hikam {programYear(intake)}</h2>
        <Divider align="center" class="mt-5" />
        <p class="mx-auto mt-6 max-w-[38rem] text-base leading-[1.8] text-ink-soft md:text-[17px]">
          We are preparing the next Hikam program and look forward to welcoming a new group of students. Course and
          registration details will be shared here when they are ready.
        </p>
        <p class="mt-5 text-ink">
          Questions about Hikam? Please contact{' '}
          <a href={`mailto:${site.email}`} class="font-medium text-raspberry underline decoration-gold underline-offset-4 hover:decoration-raspberry">{site.email}</a>.
        </p>
        <a href="/contact/?inquiry=interest-list" data-interest="hikam-foundations" class="btn btn-primary mt-8 px-7 text-base">
          Join the Interest List
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
