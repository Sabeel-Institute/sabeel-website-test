---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Lightbox from '../components/Lightbox.astro';
import { COURSE_CATEGORIES } from '../content.config';
import { courseHasPage, getPastCourses } from '../lib/content';

const YOUTH = new Set(['Youth', 'Youth Girls', 'Youth Boys', 'Kids']);

const past = await getPastCourses();
const items = await Promise.all(
  past.map(async (course) => {
    const d = course.data;
    const full = await getImage({ src: d.flyer, width: 1400 });
    return {
      course,
      full: full.src,
      year: d.date.getFullYear(),
      group: YOUTH.has(d.category) ? 'youth' : 'adult',
      search: [d.title, d.subtitle, d.summary, d.category, d.venue].filter(Boolean).join(' ').toLowerCase(),
      caption: [d.category, d.dates ?? String(d.date.getFullYear()), d.venue].filter(Boolean).join(' · '),
    };
  }),
);
const years = [...new Set(items.map((i) => i.year))].sort((a, b) => b - a);
const usedCategories = COURSE_CATEGORIES.filter((c) => past.some((p) => p.data.category === c));
---

<BaseLayout
  title="Past Courses"
  description="An archive of the courses, workshops, camps, and gatherings Sabeel Institute has offered to women, teens, and children."
>
  <PageHero title="Past Courses">
    <p>
      For more than a decade, Sabeel Institute has offered courses, workshops, camps, and gatherings for women,
      teens, and children. Browse the flyers from programs we have run.
    </p>
  </PageHero>

  <section class="pb-16" aria-label="Past course archive">
    <div class="container-page">
      <form
        role="search"
        class="-mt-2 grid gap-3 rounded-2xl border border-border bg-surface p-4 shadow-card sm:grid-cols-[minmax(0,15rem)_1fr] sm:p-5"
        data-past-filter
        onsubmit="return false"
      >
        <label class="sr-only" for="past-category">Category</label>
        <div class="relative">
          <select
            id="past-category"
            name="category"
            class="min-h-12 w-full appearance-none rounded-lg border border-border-strong bg-canvas pr-10 pl-4 text-base text-ink focus:border-raspberry focus:outline-none"
          >
            <option value="">All Categories</option>
            <option value="group:adult">Adult Programs</option>
            <option value="group:youth">Youth &amp; Kids Programs</option>
            <optgroup label="By audience">
              {usedCategories.map((c) => <option value={c}>{c}</option>)}
            </optgroup>
          </select>
          <Icon name="chevron-down" class="pointer-events-none absolute top-1/2 right-3 size-5 -translate-y-1/2 text-ink-soft" />
        </div>
        <label class="sr-only" for="past-search">Search past courses</label>
        <div class="relative">
          <Icon name="search" class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-ink-soft" />
          <input
            id="past-search"
            name="q"
            type="search"
            placeholder="Search past courses…"
            autocomplete="off"
            class="min-h-12 w-full rounded-lg border border-border-strong bg-canvas pr-4 pl-12 text-base text-ink placeholder:text-ink-soft focus:border-raspberry focus:outline-none"
          />
        </div>
      </form>
      <p class="mt-4 text-[15px] text-ink-soft" aria-live="polite" data-past-count>
        {items.length} past programs
      </p>

      {
        years.map((year) => (
          <section class="mt-10" data-year-group aria-labelledby={`year-${year}`}>
            <div class="flex items-center gap-4">
              <h2 id={`year-${year}`} class="font-display text-3xl font-bold text-raspberry">
                {year}
              </h2>
              <span class="h-px flex-1 bg-gold/60" />
            </div>
            <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
              {items
                .filter((i) => i.year === year)
                .map((i) => (
                  <li data-category={i.course.data.category} data-group={i.group} data-search={i.search}>
                    <a
                      href={i.full}
                      data-lightbox="past"
                      data-title={i.course.data.title}
                      data-caption={i.caption}
                      data-alt={`Flyer for ${i.course.data.title}`}
                      data-page={courseHasPage(i.course) ? `/courses/${i.course.id}/` : undefined}
                      class="group block"
                    >
                      <span class="block aspect-[4/5] overflow-hidden rounded-sm bg-inset shadow-card">
                        <Image
                          src={i.course.data.flyer}
                          alt=""
                          widths={[240, 360, 480]}
                          sizes="(min-width: 1024px) 300px, (min-width: 640px) 33vw, 50vw"
                          class="size-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03]"
                        />
                      </span>
                      <span class="mt-3 block text-[13px] font-bold tracking-wide text-gold-text uppercase">
                        {i.course.data.category}
                      </span>
                      <span class="mt-0.5 block leading-snug font-semibold text-raspberry group-hover:underline">
                        {i.course.data.title}
                      </span>
                      {i.course.data.subtitle && (
                        <span class="mt-0.5 block text-[15px] leading-snug text-ink-soft">{i.course.data.subtitle}</span>
                      )}
                    </a>
                  </li>
                ))}
            </ul>
          </section>
        ))
      }
      <p class="mt-10 hidden rounded-card border border-border bg-surface p-7 text-center text-ink-soft" data-past-empty>
        No past courses match your search.
      </p>
    </div>
  </section>

  <Lightbox />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-past-filter]')!;
  const count = document.querySelector<HTMLElement>('[data-past-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-past-empty]')!;
  const items = [...document.querySelectorAll<HTMLElement>('[data-search]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-year-group]')];

  function apply() {
    const data = new FormData(form);
    const category = String(data.get('category') ?? '');
    const terms = String(data.get('q') ?? '').toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const item of items) {
      const catOk = !category
        || (category.startsWith('group:') ? item.dataset.group === category.slice(6) : item.dataset.category === category);
      const textOk = terms.every((t) => item.dataset.search!.includes(t));
      item.hidden = !(catOk && textOk);
      if (!item.hidden) shown++;
    }
    for (const g of groups) g.hidden = !g.querySelector('[data-search]:not([hidden])');
    count.textContent = `${shown} past ${shown === 1 ? 'program' : 'programs'}`;
    empty.classList.toggle('hidden', shown > 0);
  }
  form.addEventListener('input', apply);
  form.addEventListener('change', apply);
</script>
