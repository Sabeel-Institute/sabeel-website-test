---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FlyerArchive from '../components/FlyerArchive.astro';
import Lightbox from '../components/Lightbox.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCompletedPrograms } from '../lib/content';

const all = await getCompletedPrograms();
---

<BaseLayout
  title="Past Programs"
  description="A growing record of the courses, camps, and gatherings Sabeel Institute has offered to women, youth, and children."
>
  <PageHero
    eyebrow="Past programs"
    title="A growing record of learning at Sabeel."
    photo="past-programs-hero"
    photoAlt="A past Sabeel class"
    photoIcon="book-open"
  >
    <p>
      Explore flyers from our previous offerings for women, youth, and children, year by year. Each one links to its
      program’s page.
    </p>
  </PageHero>

  <section class="py-14 md:py-16" aria-labelledby="archive-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Program archive" title="Past programs by year." id="archive-heading">
        <p>{all.length} programs so far, across all three program areas.</p>
      </SectionHeading>
      <div class="mt-10">
        <FlyerArchive programs={all} id="archive" showArea />
      </div>
    </div>
  </section>

  <CtaBand title="Looking for something current?">
    <p>Return to Programs to see what is open for registration now.</p>
    <a slot="actions" href="/programs/" class="btn btn-primary px-7 text-base">View Current Programs</a>
  </CtaBand>
  <Lightbox />
</BaseLayout>
