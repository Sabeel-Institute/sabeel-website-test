---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Divider from '../../components/Divider.astro';
import TeamCard from '../../components/TeamCard.astro';
import { TEAM_GROUPS, getTeamGroup } from '../../lib/content';

const groups = await Promise.all(TEAM_GROUPS.map(async (g) => ({ ...g, members: await getTeamGroup(g.key) })));
---

<BaseLayout
  title="Our Team"
  description="Meet the board, teachers, and volunteers of Sabeel Institute — Alimiyyah graduates and dedicated students serving the Houston community."
>
  <PageHero title="Our Team">
    <p>
      Sabeel Institute is led by women trained in the Islamic sciences and carried by students who stayed to
      serve. Meet our board, our teachers, and the admin staff and volunteers behind every program.
    </p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {
        groups.map((g) => (
          <li>
            <a
              href={`#${g.anchor}`}
              class="inline-flex min-h-10 items-center rounded-full border border-gold bg-surface px-4 text-[15px] text-ink hover:border-raspberry hover:text-raspberry"
            >
              {g.title}
            </a>
          </li>
        ))
      }
    </ul>
  </PageHero>

  {
    groups.map((g, i) => (
      <section
        id={g.anchor}
        class:list={['scroll-mt-6 py-14 md:py-16', i % 2 === 1 && 'bg-surface']}
        aria-labelledby={`${g.anchor}-heading`}
      >
        <div class="container-page">
          <h2 id={`${g.anchor}-heading`} class="heading-sans uppercase">
            {g.title}
          </h2>
          <Divider class="mt-4" />
          <p class="mt-5 max-w-[42rem] leading-[1.8] text-ink-soft">{g.intro}</p>
          <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.members.map((m) => (
              <li>
                <TeamCard member={m} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }
</BaseLayout>
