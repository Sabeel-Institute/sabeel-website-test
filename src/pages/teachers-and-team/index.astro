---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Divider from '../../components/Divider.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import TeamCard from '../../components/TeamCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { displayName, getTeamGroup } from '../../lib/content';

const founder = (await getEntry('team', 'sameera-shah'))!;
const board = await getTeamGroup('board');
const teachers = await getTeamGroup('teachers');

const serviceAreas = [
  {
    title: 'Teaching & Mentorship',
    text: 'Sharing sacred knowledge and nurturing our students. Graduates of Sabeel’s three-year Classical Islamic Knowledge and two-year Hikam Foundations certification programs give bayans, contribute to sacred season programs and summer youth intensives, and teach children’s courses.',
  },
  {
    title: 'Technology, Communications & Outreach',
    text: 'Supporting our online programs and helping people connect with Sabeel through technical support, design, flyers, emails, social media, and community outreach.',
  },
  {
    title: 'Program & Community Support',
    text: 'Caring for the many details that bring our programs to life — from preparing classrooms and supporting students to helping with events, seasonal programs, and fundraising.',
  },
];
---

<BaseLayout
  title="Teachers & Team"
  description="Sabeel Institute’s Houston-based teaching team: women trained in traditional Islamic scholarship, Qur’an recitation, education, and mentoring."
>
  <PageHero
    eyebrow="Teachers and program leaders"
    title="Women trained to teach, mentor, and carry learning forward."
    photo="team-hero"
    photoAlt="Sabeel’s teaching team"
    photoIcon="users"
  >
    <p>
      Sabeel Institute’s Houston-based teaching team brings together women trained in traditional Islamic
      scholarship, Qur’an recitation, education, and mentoring. In person and live online, they teach Arabic grammar,
      Qur’an and tafsir, hadith, fiqh, spirituality, character, and service.
    </p>
  </PageHero>

  <!-- Founder -->
  <section id="founder" class="scroll-mt-6 bg-sage-mist py-14 md:py-16" aria-labelledby="founder-heading">
    <div class="container-page grid items-center gap-10 md:grid-cols-2 md:gap-16">
      <Photo slot="founder" alt="Ustadhah Sameera Shah teaching" class="aspect-[4/3] shadow-card max-md:order-last" />
      <div>
        <p class="eyebrow">{founder.data.role}</p>
        {founder.data.sub && <p class="mt-1 text-sm font-medium text-ink-soft">{founder.data.sub}</p>}
        <h2 id="founder-heading" class="display-md mt-2 sm:text-[2.4rem]">Meet {displayName(founder)}.</h2>
        <Divider class="mt-4" />
        <p class="mt-5 text-[17px] leading-[1.85] text-ink">
          Sameera Shah leads Sabeel’s educational vision. She earned a B.Sc. (Honors) in
          Economics from LUMS, completed her ‘Alimiyyah credential through Wifaq ul Madaris in 2009, and later
          completed certification in Advanced Qur’an Study and Tafsir and in Advanced Islamic Jurisprudence through
          Whitethread Institute.
        </p>
        <a href={`/teachers-and-team/${founder.id}/`} class="link-arrow mt-5 text-lg">
          Read Sameera’s bio <Icon name="arrow-right" class="size-5" />
        </a>
      </div>
    </div>
  </section>

  <!-- Board -->
  <section id="board" class="scroll-mt-6 py-14 md:py-16" aria-labelledby="board-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Board & leadership" title="Guiding Sabeel’s work" id="board-heading" />
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          board.map((m) => (
            <li>
              <TeamCard member={m} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Teaching team -->
  <section id="teachers" class="scroll-mt-6 border-t border-border py-14 md:py-16" aria-labelledby="teachers-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Teaching team" title="Our ‘Alimiyyah-Qualified Teachers" id="teachers-heading" />
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          teachers.slice(0, 3).map((m) => (
            <li>
              <TeamCard member={m} />
            </li>
          ))
        }
      </ul>
      {
        teachers.length > 3 && (
          <>
            <ul id="more-teachers" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" hidden>
              {teachers.slice(3).map((m) => (
                <li>
                  <TeamCard member={m} />
                </li>
              ))}
            </ul>
            <div class="mt-8 flex justify-center">
              <button type="button" class="btn btn-primary px-8" aria-expanded="false" aria-controls="more-teachers" data-more-teachers>
                See more teachers
              </button>
            </div>
          </>
        )
      }
      <details class="group mt-8 rounded-r-card border-l-4 border-raspberry bg-sage-mist">
        <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 [&::-webkit-details-marker]:hidden">
          <span class="text-lg font-medium text-ink">What is ‘Alimiyyah?</span>
          <span class="shrink-0 font-medium text-raspberry">
            <span class="group-open:hidden">Read explanation</span>
            <span class="hidden group-open:inline">Hide explanation</span>
          </span>
        </summary>
        <p class="max-w-3xl px-6 pb-6 leading-[1.8] text-ink">
          An ‘Alimiyyah degree is a traditional four- to six-year program devoted to the in-depth study of the Islamic
          sciences, including the Qur’an, Hadith, Islamic law, theology, and Arabic. Through years of structured study
          under scholars, graduates develop a strong foundation in the Islamic tradition — one that informs their
          teaching and the care they bring to sharing sacred knowledge.
        </p>
      </details>
    </div>
  </section>

  <!-- Sacred Service Team -->
  <section id="serve" class="scroll-mt-6 border-t border-border" aria-labelledby="serve-heading">
    <div class="container-page py-14 md:py-16">
      <div class="max-w-3xl">
        <p class="eyebrow">Our Sacred Service Team</p>
        <h2 id="serve-heading" class="display-md mt-1 tracking-[0.08em] uppercase sm:text-[2.35rem]">Learn. Reflect. Serve.</h2>
        <Divider class="mt-4" />
        <div class="mt-5 space-y-4 text-[17px] leading-[1.85] text-ink">
          <p>
            The bonds nurtured through learning and suhbah endure at Sabeel: students who studied with us over a decade
            ago still serve alongside us. Our Sacred Service Team brings together more than 30 graduates, students, and
            volunteers who sustain Sabeel through the time, skills, and care they give.
          </p>
          <p>
            Some have faithfully carried an ongoing responsibility for years; others lend a hand during a particular
            program or season. We are deeply grateful for each contribution, including the quiet work that so often goes
            unseen.
          </p>
        </div>
      </div>
    </div>
    <div class="bg-sage-mist py-14 md:py-16">
      <ul class="container-page grid gap-5 md:grid-cols-3">
        {
          serviceAreas.map((area) => (
            <li class="rounded-card border border-gold/60 border-t-4 border-t-gold bg-surface p-6">
              <h3 class="text-xl font-semibold text-ink">{area.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{area.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="container-page py-12 text-center md:py-14">
      <Divider align="center" />
      <p class="mt-5 font-display text-2xl text-raspberry sm:text-[1.9rem]">
        May Allah accept their service and reward them abundantly.
      </p>
    </div>
  </section>

  <CtaBand title="Learn with the team">
    <p>Explore current programs for women, youth, and families, offered in Houston and live online.</p>
    <a slot="actions" href="/programs/" class="btn btn-primary px-7 text-base">View Programs</a>
  </CtaBand>
</BaseLayout>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-more-teachers]')) {
    const list = document.getElementById(button.getAttribute('aria-controls')!)!;
    const show = (open: boolean) => {
      list.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open ? 'Show fewer teachers' : 'See more teachers';
    };
    const isOpen = () => button.getAttribute('aria-expanded') === 'true';
    button.addEventListener('click', () => show(!isOpen()));
    // A link to a teacher's card, such as a bio's "Back to Teachers & Team",
    // opens the list when the card is in it.
    const reveal = () => {
      const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (target && list.contains(target) && !isOpen()) {
        show(true);
        target.scrollIntoView();
      }
    };
    reveal();
    addEventListener('hashchange', reveal);
  }
</script>
