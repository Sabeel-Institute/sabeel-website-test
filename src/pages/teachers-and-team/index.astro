---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Divider from '../../components/Divider.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import TeamCard from '../../components/TeamCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getTeamGroup, initials } from '../../lib/content';

const founder = (await getEntry('team', 'sameera-shah'))!;
const board = await getTeamGroup('board');
const teachers = await getTeamGroup('teachers');
const words = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const count = (n: number) => words[n] ?? String(n);
---

<BaseLayout
  title="Teachers & Team"
  description="Sabeel Institute’s Houston-based teaching team: women trained in traditional Islamic scholarship, Qur’an recitation, education, and mentoring."
>
  <PageHero
    eyebrow="Teachers and program leaders"
    title="Women trained to teach, mentor, and carry learning forward."
    photo="team-hero"
    photoAlt="Sabeel’s teaching team"
    photoIcon="users"
  >
    <p>
      Sabeel Institute’s Houston-based teaching team brings together women trained in traditional Islamic
      scholarship, Qur’an recitation, education, and mentoring. In person and live online, they teach Arabic grammar,
      Qur’an and tafsir, hadith, fiqh, spirituality, character, and service.
    </p>
  </PageHero>

  <!-- Founder -->
  <section id="founder" class="scroll-mt-6 bg-sage-mist py-14 md:py-16" aria-labelledby="founder-heading">
    <div class="container-page grid items-center gap-10 md:grid-cols-2 md:gap-16">
      <Photo slot="founder" alt="Ust. Sameera Shah teaching" monogram={initials(founder.data.name)} class="aspect-[4/3] shadow-card" />
      <div>
        <p class="eyebrow">Founder</p>
        <p class="mt-1 text-sm font-medium text-ink-soft">Executive Director and Teacher</p>
        <h2 id="founder-heading" class="display-md mt-2 sm:text-[2.4rem]">Meet Ust. Sameera Shah.</h2>
        <Divider class="mt-4" />
        <p class="mt-5 text-[17px] leading-[1.85] text-ink">
          Founder Sameera Shah leads Sabeel’s educational vision. She earned a B.Sc. (Honors) in
          Economics from LUMS, completed her ‘Alimiyyah credential through Wifaq ul Madaris in 2009, and later
          completed advanced certificates in Qur’an study and tafsir and in Islamic jurisprudence through Whitethread
          Institute.
        </p>
        <a href={`/teachers-and-team/${founder.id}/`} class="link-arrow mt-5 text-lg">
          Read Sameera’s bio <Icon name="arrow-right" class="size-5" />
        </a>
      </div>
    </div>
  </section>

  <!-- Board -->
  <section id="board" class="scroll-mt-6 py-14 md:py-16" aria-labelledby="board-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Board & leadership" title="Guiding Sabeel’s work" id="board-heading" />
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          board.map((m) => (
            <li>
              <TeamCard member={m} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Teaching team -->
  <section id="teachers" class="scroll-mt-6 border-t border-border bg-surface py-14 md:py-16" aria-labelledby="teachers-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Teaching team" title="Our ‘Alimiyyah-Qualified Teachers" id="teachers-heading" />

      <!-- Main 3 Teachers -->
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          teachers.slice(0, 3).map((m) => (
            <li>
              <TeamCard member={m} />
            </li>
          ))
        }
      </ul>

      <!-- Additional Teachers (toggleable) -->
      {
        teachers.length > 3 && (
          <details class="group mt-6">
            <summary class="inline-flex cursor-pointer items-center gap-2 rounded-md border border-gold/60 bg-sage-wash px-5 py-2.5 font-medium text-raspberry transition-colors hover:bg-sage-mist">
              <span class="group-open:hidden">See more teachers</span>
              <span class="hidden group-open:inline">Show fewer teachers</span>
              <Icon name="chevron-down" class="size-4 transition-transform group-open:rotate-180" />
            </summary>
            <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {teachers.slice(3).map((m) => (
                <li>
                  <TeamCard member={m} />
                </li>
              ))}
            </ul>
          </details>
        )
      }
    </div>
  </section>

  <!-- Qualified / serve -->
  <section class="py-14 md:py-16">
    <div class="container-page grid gap-5 md:grid-cols-2">
      <div class="rounded-card border border-gold/60 border-t-4 border-t-gold bg-surface p-7 sm:p-9">
        <h2 class="font-display text-[1.8rem] font-bold text-raspberry">What “qualified” means here</h2>
        <p class="mt-3 leading-[1.8] text-ink-soft">
          ‘Alimiyyah degree is a traditional four- to six-year program devoted to the in-depth study of the Islamic sciences, including the Qur’an, Hadith, Islamic law, theology, and Arabic. Through years of structured study under scholars, graduates develop a strong foundation in the Islamic tradition; one that informs their teaching and the care they bring to sharing sacred knowledge.
        </p>
      </div>
      <div id="serve" class="scroll-mt-6 rounded-card border border-gold/60 border-t-4 border-t-gold bg-surface p-7 sm:p-9">
        <h2 class="font-display text-[1.8rem] font-bold text-raspberry">Sabeel’s Sacred Service Volunteer Team</h2>
        <p class="mt-3 leading-[1.8] text-ink-soft">
          At the heart of Sabeel is a dedicated team of certification program graduates and past and current students who bring sacred service to life. From marketing and caring for our new classroom to supporting on-site and live online programs, they give their time, talents, and hearts to help our students and community thrive.
        </p>
      </div>
    </div>
  </section>

  <CtaBand title="Learn with the team">
    <p>Explore current programs for women, youth, and families, offered in Houston and live online.</p>
    <a slot="actions" href="/programs/" class="btn btn-primary px-7 text-base">View Programs</a>
  </CtaBand>
</BaseLayout>
