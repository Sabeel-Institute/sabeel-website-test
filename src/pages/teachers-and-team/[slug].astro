---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/Divider.astro';
import Lattice from '../../components/illumination/Lattice.astro';
import Frame from '../../components/illumination/Frame.astro';
import Headpiece from '../../components/illumination/Headpiece.astro';
import Shamsa from '../../components/illumination/Shamsa.astro';
import Icon from '../../components/Icon.astro';
import { displayName, excerpt, teamHasPage, type TeamMember } from '../../lib/content';

export const getStaticPaths = (async () => {
  const members = await getCollection('team', teamHasPage);
  return members.map((member) => ({ params: { slug: member.id }, props: { member } }));
}) satisfies GetStaticPaths;

interface Props {
  member: TeamMember;
}

// Titles match the section eyebrows on /teachers-and-team/.
const GROUP = {
  founder: { title: 'Founder', anchor: 'founder' },
  board: { title: 'Board & leadership', anchor: 'board' },
  teachers: { title: 'Teaching team', anchor: 'teachers' },
  volunteers: { title: 'Our Sacred Service Team', anchor: 'serve' },
} as const;

const { member } = Astro.props;
const { Content } = await render(member);
const group = GROUP[member.data.group];
const name = displayName(member);
---

<BaseLayout title={name} description={excerpt(member.body, 40)}>
  <section class="relative overflow-hidden bg-canvas pt-8 pb-16 md:pb-20">
    <Lattice class="text-gold opacity-[0.08]" fade />
    <Shamsa class="absolute top-24 right-0 hidden w-[32rem] translate-x-1/3 text-gold opacity-[0.12] md:block" />
    <Frame />
    <div class="container-page relative">
      <nav aria-label="Breadcrumb" class="text-[15px] text-ink-soft">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/teachers-and-team/" class="hover:text-raspberry">Teachers &amp; Team</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">{name}</li>
        </ol>
      </nav>

      <div class="mt-10">
        <div>
          <Headpiece class="mb-7 w-full max-w-[30rem] text-gold" />
          <p class="eyebrow">{group.title}</p>
          <h1 class="display-lg mt-5">{name}</h1>
          <Divider width="sm" class="mt-4" />
          {member.data.role && <p class="mt-2 text-lg font-semibold text-ink">{member.data.role}</p>}
          {member.data.sub && <p class="mt-1 text-base text-ink-soft">{member.data.sub}</p>}
          {
            member.data.highlights && (
              <ul class="mt-4 space-y-1 text-ink-soft">
                {member.data.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )
          }
          <Divider class="mt-6" />
          <div class="prose-sabeel mt-8 max-w-[44rem] text-[17px] leading-[1.85] text-ink-soft">
            <Content />
          </div>
          <a href={`/teachers-and-team/#${member.data.group === 'founder' ? group.anchor : member.id}`} class="link-arrow mt-10">
            <Icon name="arrow-left" class="size-5" /> Back to Teachers &amp; Team
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
