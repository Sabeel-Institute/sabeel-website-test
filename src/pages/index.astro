---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import ProgramCard from '../components/ProgramCard.astro';
import MailingListForm from '../components/MailingListForm.astro';
import SabeelDifference from '../components/SabeelDifference.astro';
import Gallery from '../components/Gallery.astro';
import teacherPhoto from '../assets/photos/team-hero.webp';
import servicePhoto from '../content/gallery/womens-class.webp';
import { getCurrentPrograms, getGalleryPhotos } from '../lib/content';

const featured = (await getCurrentPrograms()).slice(0, 3);
const gallery = await getGalleryPhotos();
---

<BaseLayout>
  <PageHero
    eyebrow="About Sabeel Institute"
    title="Take your Islamic learning further."
    large
  >
    <p class="font-display text-[1.35rem] leading-[1.5] sm:text-[1.45rem]">
      Structured, in-person Islamic learning for women in Houston — from classes and gatherings to sustained study
      with women trained in the Islamic sciences.
    </p>
    <a slot="actions" href="/programs/" class="btn btn-primary px-7 text-sm tracking-wide uppercase">Explore Programs</a>
  </PageHero>

  <SabeelDifference />

  <!-- Open for registration -->
  <section class="py-14 md:py-16" aria-labelledby="open-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Current opportunities" title="Open for registration" id="open-heading">
        <p>Explore current classes, gatherings, and programs for women, teens, and children.</p>
        <a href="/programs/" class="link-arrow mt-3 font-semibold">
          View all programs <Icon name="arrow-right" class="size-5" />
        </a>
      </SectionHeading>
      {
        featured.length > 0 ? (
          <ul class="card-grid mt-10">
            {featured.map((p) => (
              <li>
                <ProgramCard program={p} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-10 rounded-card border border-border bg-surface p-7 text-ink-soft">
            Registration for our next programs opens soon. Sign up below to hear first.
          </p>
        )
      }
    </div>
  </section>

  <!-- Teachers and service -->
  <section class="pb-14 md:pb-20">
    <div class="container-page grid gap-5 lg:grid-cols-2">
      {
        [
          {
            image: teacherPhoto,
            alt: 'Sabeel teachers and team members in study',
            title: 'Meet the teachers',
            text: 'Learn from ‘Alimiyyah graduates who pair rigorous training in the Islamic sciences with clarity, care, and an understanding of the questions women are carrying today.',
            link: 'Meet the teaching team',
            href: '/teachers-and-team/#teachers',
          },
          {
            image: servicePhoto,
            alt: 'Sabeel students sitting together in class',
            title: 'From student to service',
            text: 'At Sabeel, learning is meant to be lived. Students carry what they gain into their homes, masajid, classrooms, and communities — serving with greater knowledge, confidence, and ihsan.',
            link: 'Meet our Sacred Service Team',
            href: '/teachers-and-team/#serve',
          },
        ].map((card) => (
          <article class="flex flex-col gap-6 rounded-card border-2 border-gold/25 bg-surface p-7 sm:flex-row sm:items-center sm:gap-8 sm:p-10">
            <Image src={card.image} alt={card.alt} width={280} class="size-28 shrink-0 rounded-full border-2 border-gold/30 object-cover shadow-card sm:size-[132px]" />
            <div>
              <h2 class="font-display text-[2rem] leading-tight font-bold text-raspberry">{card.title}</h2>
              <p class="mt-3 leading-[1.8] text-ink-soft">{card.text}</p>
              <a href={card.href} class="link-arrow mt-4">
                {card.link} <Icon name="arrow-right" class="size-5" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {gallery.length > 0 && <Gallery photos={gallery} />}

  <!-- Stay connected -->
  <section class="bg-raspberry py-10 text-on-raspberry" aria-labelledby="stay-heading">
    <div class="container-page grid items-center gap-6 md:grid-cols-[1fr_minmax(0,30rem)] md:gap-12">
      <div>
        <h2 id="stay-heading" class="font-display text-[1.9rem] font-bold tracking-wide text-gold uppercase">Stay connected</h2>
        <Divider width="sm" class="mt-2" />
        <p class="mt-3 text-on-raspberry">Subscribe for program announcements, resources, and reminders.</p>
      </div>
      <MailingListForm id="home-newsletter" tone="dark" />
    </div>
  </section>
</BaseLayout>
