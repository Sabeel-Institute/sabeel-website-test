---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import ProgramCard from '../components/ProgramCard.astro';
import MailingListForm from '../components/MailingListForm.astro';
import SabeelDifference from '../components/SabeelDifference.astro';
import Gallery from '../components/Gallery.astro';
import Lattice from '../components/illumination/Lattice.astro';
import Frame from '../components/illumination/Frame.astro';
import teacherIcon from '../assets/images/icon-teacher.png';
import serviceIcon from '../assets/images/icon-service.png';
import { getCurrentPrograms, getGalleryPhotos } from '../lib/content';

const featured = (await getCurrentPrograms()).slice(0, 3);
const gallery = await getGalleryPhotos();
---

<BaseLayout>
  <PageHero eyebrow="About Sabeel Institute" title="Take your Islamic learning further." large>
    <p>
      Structured, in-person Islamic learning for women in Houston — from classes and gatherings to sustained study
      with women trained in the Islamic sciences.
    </p>
    <a slot="actions" href="/programs/" class="btn btn-primary px-8">Explore Programs</a>
  </PageHero>

  <SabeelDifference />

  <!-- Open for registration -->
  <section class="py-20 lg:py-28" aria-labelledby="open-heading">
    <div class="container-page">
      <SectionHeading number="01" eyebrow="Current opportunities" title="Open for registration" id="open-heading">
        <p>Explore current classes, gatherings, and programs for women, teens, and children.</p>
        <a href="/programs/" class="link-arrow mt-3 font-semibold">
          View all programs <Icon name="arrow-right" class="size-5" />
        </a>
      </SectionHeading>
      {
        featured.length > 0 ? (
          <ul class="entry-list mt-8 border-b border-gold/40">
            {featured.map((p) => (
              <li>
                <ProgramCard program={p} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="card-illuminated mt-10 rounded-card p-7 text-ink-soft">
            Registration for our next programs opens soon. Sign up below to hear first.
          </p>
        )
      }
    </div>
  </section>

  <!-- Teachers and service -->
  <section class="pb-20 lg:pb-28">
    <div class="container-page grid gap-6 lg:grid-cols-2 lg:gap-8">
      {
        [
          {
            icon: teacherIcon,
            title: 'Meet the teachers',
            text: 'Learn from ‘Alimiyyah graduates who pair rigorous training in the Islamic sciences with clarity, care, and an understanding of the questions women are carrying today.',
            link: 'Meet the teaching team',
            href: '/teachers-and-team/#teachers',
          },
          {
            icon: serviceIcon,
            title: 'From student to service',
            text: 'At Sabeel, learning is meant to be lived. Students carry what they gain into their homes, masajid, classrooms, and communities — serving with greater knowledge, confidence, and ihsan.',
            link: 'Meet our Sacred Service Team',
            href: '/teachers-and-team/#serve',
          },
        ].map((card) => (
          <article class="card-illuminated card-lift rise flex flex-col gap-8 rounded-card p-8 sm:flex-row sm:items-center sm:gap-10 lg:p-12">
            <Image src={card.icon} alt="" width={160} class="size-32 shrink-0 lg:size-[150px]" />
            <div>
              <h2 class="display-md">{card.title}</h2>
              <p class="mt-4 leading-[1.8] text-ink-soft">{card.text}</p>
              <a href={card.href} class="link-arrow mt-5">
                {card.link} <Icon name="arrow-right" class="size-5" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {gallery.length > 0 && <Gallery photos={gallery} number="02" />}

  <!-- Stay connected -->
  <section class="relative overflow-clip bg-raspberry py-20 text-on-raspberry lg:py-28" aria-labelledby="stay-heading">
    <Lattice class="text-gold opacity-[0.16]" />
    <Frame />
    <div class="container-page relative grid items-center gap-10 lg:grid-cols-[1fr_minmax(0,32rem)] lg:gap-16">
      <div>
        <h2 id="stay-heading" class="display-lg text-gold tracking-[0.06em] uppercase">Stay connected</h2>
        <Divider width="sm" class="mt-5" />
        <p class="lead mt-6 text-on-raspberry">Subscribe for program announcements, resources, and reminders.</p>
      </div>
      <MailingListForm id="home-newsletter" tone="dark" />
    </div>
  </section>
</BaseLayout>
