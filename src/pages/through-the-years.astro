---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { programHref } from '../lib/content';

const milestones = await Promise.all(
  (await getCollection('milestones'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (m) => ({
    ...m.data,
    id: m.id,
    program: m.data.program ? await getEntry(m.data.program) : undefined,
  })),
);
---

<BaseLayout
  title="Through the Years"
  description="Selected moments from Sabeel’s journey: sustained women’s learning, next-generation programs, and knowledge carried forward."
>
  <PageHero
    eyebrow="A living history of learning"
    title="Selected moments from Sabeel’s journey."
    photo="history-hero"
    photoAlt="An archival photograph of an early Sabeel class"
    photoIcon="leaf"
  >
    <p>A concise history of sustained women’s learning, next-generation programs, and knowledge carried forward.</p>
  </PageHero>

  <section class="py-14 md:py-16" aria-labelledby="milestones-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Curated — not complete" title="Milestones" id="milestones-heading">
        <p>Dates are added as they are confirmed against registration records, flyers, and program leads.</p>
      </SectionHeading>
      <ol class="mt-10 border-t border-gold/60">
        {
          milestones.map((m) => {
            const image = m.program?.data.image ?? m.program?.data.flyer;
            return (
              <li class="grid gap-5 border-b border-gold/60 py-7 sm:grid-cols-[7rem_10rem_1fr] sm:items-center sm:gap-8">
                <p class="font-display text-2xl font-bold text-gold-text">
                  {m.year ?? <span class="sr-only">Year to be confirmed</span>}
                  {!m.year && <span aria-hidden="true" class="inline-block size-3 rotate-45 bg-gold" />}
                </p>
                {image ? (
                  <Image src={image} alt="" widths={[160, 320]} sizes="160px" class="aspect-[4/3] w-40 rounded-sm object-cover object-top shadow-card" />
                ) : (
                  <Photo slot={`milestone-${m.id}`} alt="" class="aspect-[4/3] w-40 rounded-sm" />
                )}
                <div>
                  <h2 class="text-xl font-semibold text-ink">{m.title}</h2>
                  <p class="mt-1 max-w-[44rem] leading-[1.75] text-ink-soft">{m.text}</p>
                  {m.program && (
                    <a href={programHref(m.program)} class="link-arrow mt-2 text-[15px]">
                      See the program record <Icon name="arrow-right" class="size-4" />
                    </a>
                  )}
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <CtaBand title="Looking for a current program?">
    <p>See what is open for registration now.</p>
    <a slot="actions" href="/programs/" class="btn btn-primary px-7 text-base">View Open Programs</a>
  </CtaBand>
</BaseLayout>
