---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import Lightbox from '../components/Lightbox.astro';
import flyer from '../assets/images/hikam-seminary-flyer.webp';
import { site } from '../site.config';

/*
 * Seminary details. Update `term` and `status` each cycle; set `applyUrl` when
 * applications open and the page switches its buttons to "Apply Now".
 */
const seminary = {
  term: 'Fall 2026',
  status: 'Applications opening soon',
  applyUrl: null as string | null,
  highlights: [
    { icon: 'calendar', title: 'Mondays & Thursdays', text: 'Consistent weekly learning designed to fit your schedule.' },
    { icon: 'graduation-cap', title: 'High School & University Students', text: 'Designed especially for busy students, young women, and moms.' },
    { icon: 'laptop', title: 'In Person & Online', text: 'Learn wherever you are with flexible access to the program.' },
  ],
  subjects: [
    { title: 'Arabic Grammar', text: 'The language of the Qur’an, built step by step.' },
    { title: 'Tafsir', text: 'Understanding the meanings and themes of the Qur’an.' },
    { title: 'Hadith', text: 'The words and example of the Prophet (peace be upon him).' },
    { title: 'Fiqh', text: 'The practice of worship and daily life, grounded in its sources.' },
  ],
} as const;

const testimonials = (await getCollection('testimonials')).filter((t) => t.data.program === 'Certification Program');
const prep = (await getCollection('courses', (c) => c.data.status === 'open' && c.id.startsWith('quran-immersion')))[0];
const flyerFull = await getImage({ src: flyer, width: 1254 });
const askHref = `mailto:${site.email}?subject=${encodeURIComponent(`Hikam Seminary ${seminary.term}`)}`;
---

<BaseLayout
  title="Hikam Seminary"
  description="Hikam Seminary: a one-year certification program through the essential Islamic sciences, in person in Houston and online."
  shareImage={flyer}
>
  <PageHero title="Hikam Seminary" eyebrow="Sabeel Institute">
    <p>A one-year journey through the essential Islamic sciences.</p>
    <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-gold bg-surface px-4 py-2 text-[15px] font-medium text-ink">
      <Icon name="sparkle" class="size-4 text-gold" />
      {seminary.term} · {seminary.status}
    </p>
  </PageHero>

  <!-- Certification card -->
  <section class="py-12 md:py-16">
    <div class="container-page">
      <div class="relative rounded-sm border border-gold/80 bg-surface px-5 py-12 text-center sm:px-10 md:py-14">
        <Icon name="sparkle" class="absolute top-6 left-6 size-5 text-gold" />
        <Icon name="sparkle" class="absolute right-6 bottom-6 size-5 text-gold" />
        <p class="font-label text-[15px] font-bold tracking-[0.18em] text-gold-text uppercase">Sabeel Institute</p>
        <h2 class="mt-3 font-display text-5xl font-bold text-raspberry sm:text-6xl">One-Year</h2>
        <Divider align="center" width="sm" class="mt-4" />
        <p class="mt-5 font-display text-2xl text-ink-soft sm:text-[1.7rem]">Certification Program</p>

        <ul class="mt-10 grid gap-10 md:grid-cols-3 md:gap-0">
          {
            seminary.highlights.map((h, i) => (
              <li class:list={['px-4 md:px-8', i > 0 && 'md:border-l md:border-border-strong']}>
                <span class="mx-auto flex size-[74px] items-center justify-center rounded-full bg-raspberry text-on-raspberry">
                  <Icon name={h.icon} class="size-8" />
                </span>
                <h3 class="mt-4 font-display text-[1.7rem] leading-tight font-bold text-raspberry">{h.title}</h3>
                <p class="mt-2 text-[15px] text-ink-soft">{h.text}</p>
              </li>
            ))
          }
        </ul>
        <p class="mt-10 font-label text-sm font-bold tracking-[0.16em] text-gold-text uppercase">Small cohort learning</p>
      </div>
    </div>
  </section>

  <!-- Curriculum -->
  <section class="bg-sage-wash py-14 md:py-16" aria-labelledby="subjects-heading">
    <div class="container-page">
      <h2 id="subjects-heading" class="display-md text-center">What You’ll Study</h2>
      <Divider align="center" class="mt-4" />
      <p class="mx-auto mt-5 max-w-[40rem] text-center leading-[1.8] text-ink">
        Taught by female Alimiyyah graduates, with an emphasis on spirituality, sisterhood, and service.
      </p>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          seminary.subjects.map((s) => (
            <li class="rounded-card border-t-4 border-gold bg-surface p-6">
              <h3 class="font-display text-2xl font-bold text-raspberry">{s.title}</h3>
              <p class="mt-2 text-[15px] text-ink-soft">{s.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Mission band and journey -->
  <section class="py-14 md:py-16">
    <div class="container-page">
      <div class="rounded-sm bg-raspberry px-6 py-12 text-center text-on-raspberry md:py-14">
        <h2 class="font-display text-4xl font-bold tracking-[0.08em] uppercase sm:text-5xl">Our Mission</h2>
        <p class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-display text-2xl tracking-[0.2em] uppercase sm:text-3xl">
          <span>Learn</span><span class="size-3.5 rotate-45 bg-gold" aria-hidden="true"></span><span>Reflect</span><span
            class="size-3.5 rotate-45 bg-gold"
            aria-hidden="true"></span><span>Serve</span>
        </p>
      </div>

      {
        testimonials.length > 0 && (
          <div class="mt-14">
            <h2 class="display-md text-center">From Our Certification Students</h2>
            <Divider align="center" class="mt-4" />
            <ul class="mt-10 grid gap-5 md:grid-cols-2">
              {testimonials.map((t) => (
                <li>
                  <figure class="h-full rounded-card border border-border bg-surface p-7">
                    <Icon name="quote" class="size-7 text-gold" />
                    <blockquote class="mt-3 font-display text-xl leading-snug text-ink">{t.data.quote}</blockquote>
                    <figcaption class="mt-4 text-sm font-bold tracking-wide text-gold-text uppercase">
                      {t.data.program}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="mt-16 grid items-center gap-10 rounded-card bg-surface p-7 sm:p-10 md:grid-cols-[1fr_minmax(0,320px)]">
        <div class="text-center md:text-left">
          <h2 class="font-display text-4xl font-bold text-raspberry sm:text-5xl">Begin Your Journey</h2>
          <p class="mt-4 font-display text-xl text-ink-soft sm:text-2xl">
            Explore knowledge, strengthen your faith, and grow with a supportive sisterhood.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
            {
              seminary.applyUrl ? (
                <a href={seminary.applyUrl} class="btn btn-primary px-8 text-sm tracking-wide uppercase" target="_blank" rel="noopener">
                  Apply Now <Icon name="external" class="size-4" />
                </a>
              ) : (
                <a href={askHref} class="btn btn-primary px-8 text-sm tracking-wide uppercase">
                  Ask About the Seminary
                </a>
              )
            }
            {
              prep && (
                <a href={`/courses/${prep.id}/`} class="btn btn-outline px-6 text-sm tracking-wide uppercase">
                  Prepare with Quran Immersion
                </a>
              )
            }
          </div>
          <p class="mt-5 text-[15px] text-ink-soft">
            Finances should never be a barrier — <a href="/financial-aid/" class="text-raspberry underline decoration-gold underline-offset-4">financial aid</a> is available.
          </p>
        </div>
        <a
          href={flyerFull.src}
          data-lightbox="seminary"
          data-title={`Hikam Seminary ${seminary.term}`}
          data-alt="Hikam Seminary flyer"
          class="group relative mx-auto block w-full max-w-[320px] overflow-hidden rounded-sm shadow-card"
        >
          <Image src={flyer} alt="Hikam Seminary flyer" widths={[320, 640]} sizes="320px" class="w-full" />
          <span class="absolute right-3 bottom-3 flex items-center gap-1.5 rounded-full bg-surface/95 px-3 py-1.5 text-sm font-medium text-ink shadow-card">
            <Icon name="zoom-in" class="size-4" /> View flyer
          </span>
        </a>
      </div>
    </div>
  </section>

  <Lightbox />
</BaseLayout>
