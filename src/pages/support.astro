---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ZeffyDialog from '../components/ZeffyDialog.astro';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';

const possibilities = [
  {
    title: 'Teachers and a core team',
    text: 'Hire people with the time to teach, plan programs, and support the families taking part.',
  },
  {
    title: 'Programs and financial aid',
    text: 'Continue learning for women, teens, and children while helping learners for whom cost is a barrier.',
  },
  {
    title: 'Suitable space',
    text: 'Be ready for a rental or masjid partnership that gives Sabeel more reliable room for classes and gatherings.',
  },
] as const;
---

<BaseLayout
  title="Make Room for More Learning"
  description="Your gift helps Sabeel offer learning and community to more women and young people in Houston. Donations are tax-deductible."
>
  <PageHero
    eyebrow="Support Sabeel"
    title="Make room for more learning at Sabeel"
    photo="rukaiya"
    photoAlt="Sr. Rukaiya Ahmed, Sabeel board member and teacher"
    photoIcon="hand-heart"
  >
    <p>
      Rukaiya Ahmed first joined Sabeel through Summer Garden while she was in high school. She later completed Sabeel’s
      three-year Classical Islamic Knowledge program. Today, she serves on Sabeel’s board and teaches young girls about Islam.
    </p>
    <p>
      Her journey shows what can happen when a learner has teachers and a community she can return to. Your gift helps
      Sabeel offer that opportunity to more women and young people in Houston.
    </p>
    <Fragment slot="actions">
      <a href={site.donation.page} target="_blank" rel="noopener" data-zeffy="donate-dialog" class="btn btn-primary px-6 text-base">
        Support Sabeel
      </a>
      <a href="#give" class="btn btn-outline px-6 text-base">Ways to give</a>
    </Fragment>
  </PageHero>

  <!-- The demand is already here -->
  <section class="py-14 md:py-16" aria-labelledby="demand-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Growing demand" title="The demand is already here" id="demand-heading" />
      <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_1.3fr] lg:items-center lg:gap-12">
        <div class="rounded-card border border-gold/70 border-t-4 border-t-gold bg-surface p-8 shadow-card">
          <p class="display-lg text-raspberry">608</p>
          <p class="mt-1 text-xl font-semibold text-ink">program registrations</p>
          <p class="mt-2 text-sm font-semibold tracking-wide text-gold-text uppercase">Sept 2025–2026</p>
          <Divider class="my-4" width="sm" />
          <p class="text-[15px] leading-relaxed text-ink-soft">
            Learners registered for Sabeel’s summer and Ramadan programs, youth workshops, women’s classes, and Qur’an study.
          </p>
        </div>
        <div class="flex flex-col justify-center">
          <p class="text-lg leading-relaxed text-ink-soft md:text-xl md:leading-relaxed">
            For more than fifteen years, Sabeel’s volunteer-run Sacred Service Team has helped make this work possible.
            Growing demand now calls for more teachers, a core team, and reliable places to learn.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What your gift helps make possible -->
  <section class="border-t border-border py-14 md:py-16" aria-labelledby="possible-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Impact" title="What your gift helps make possible" id="possible-heading" />
      <ul class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          possibilities.map((item) => (
            <li class="rounded-card border border-gold/60 border-t-4 border-t-gold bg-surface p-6 sm:p-8">
              <h3 class="text-xl font-semibold text-ink">
                {item.title}.<span class="block mt-2 font-normal text-[15px] text-ink-soft">{item.text}</span>
              </h3>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- How to give -->
  <section id="give" class="scroll-mt-6 border-y border-border bg-sage-mist py-14 md:py-16" aria-labelledby="give-heading">
    <div class="container-page max-w-4xl">
      <div class="text-center">
        <p class="eyebrow">Support Sabeel</p>
        <h2 id="give-heading" class="display-md mt-2">
          Give once or monthly to help Sabeel respond to these needs as they grow.
        </h2>
        <Divider align="center" class="mt-4" />
      </div>

      <div class="mt-10 rounded-card border border-gold/70 border-t-4 border-t-gold bg-surface p-6 shadow-card sm:p-10">
        <div class="flex flex-col items-center text-center">
          <span class="flex size-12 items-center justify-center rounded-full bg-canvas text-gold-text">
            <Icon name="heart" class="size-6" />
          </span>
          <h3 class="mt-4 text-2xl font-semibold text-ink">Give online</h3>
          <p class="mt-1 text-sm font-medium text-ink-soft">Zeffy</p>
          <div class="mt-6 w-full max-w-sm">
            <a
              href={site.donation.page}
              target="_blank"
              rel="noopener"
              data-zeffy="donate-dialog"
              class="btn btn-primary w-full py-4 text-base"
            >
              Donate online
            </a>
            <p class="mt-3 flex items-center justify-center gap-2 text-sm text-ink-soft">
              <Icon name="lock" class="size-4 text-success" /> Secure donation · Tax-deductible
            </p>
          </div>
          <p class="mt-8 text-[15px] leading-relaxed text-ink-soft max-w-2xl border-t border-border pt-6">
            Sabeel Institute is a not-for-profit Islamic educational institution in Houston. Donations are tax-deductible; our tax ID is <span class="font-semibold">{site.taxId}</span>. Online donors receive a tax receipt by email.
          </p>
        </div>
      </div>

      <p class="mt-8 text-center text-[15px] text-ink-soft">
        Know of a suitable space, or interested in discussing a larger gift? Email{' '}
        <a href="mailto:finance@oursabeel.com" class="font-medium text-raspberry underline decoration-gold underline-offset-4">
          finance@oursabeel.com
        </a>.
      </p>
    </div>
  </section>

  <ZeffyDialog id="donate-dialog" title={`Donate to ${site.name}`} label="Donation form" form={site.donation} />
</BaseLayout>
