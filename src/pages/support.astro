---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import ZeffyDialog from '../components/ZeffyDialog.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';

// What gifts help make possible.
const needs = [
  {
    icon: 'users',
    title: 'Invest in teachers and a core team',
    text: 'Qualified teachers need time to prepare and teach. Programs also need people to coordinate them and support the families taking part. Donations can help Sabeel move essential work beyond the limits of volunteer availability.',
  },
  {
    icon: 'book-open',
    title: 'Programs and financial aid',
    text: 'Continue learning for women, teens, and children while helping learners for whom cost is a barrier.',
  },
  {
    icon: 'landmark',
    title: 'Long-term home',
    text: 'Help Sabeel work toward a long-term home with reliable room for classes, youth programs, and community gatherings.',
  },
] as const;
---

<BaseLayout
  title="Support Our Work"
  description="Your gift helps Sabeel Institute offer Islamic learning to more women and young people in Houston. Donations are tax-deductible."
>
  <PageHero
    eyebrow="Support our work"
    title="Make room for more learning at Sabeel"
    photo="rukaiya"
    photoAlt="A Sabeel student taking notes in class"
    photoIcon="hand-heart"
  >
    <p>
      Rukaiya Ahmed first joined Sabeel through Summer Garden while she was in high school. She later completed
      Sabeel’s three-year Classical Islamic Knowledge program. Today, she serves on Sabeel’s board and teaches young
      girls about Islam.
    </p>
    <p>
      Her journey shows what can happen when a learner has teachers and a community she can return to. Your gift helps
      Sabeel offer that opportunity to more women and young people in Houston.
    </p>
    <p>
      <a href="/teachers-and-team/rukaiya-ahmed/" class="link-arrow">
        Read Rukaiya’s bio <Icon name="arrow-right" class="size-4" />
      </a>
    </p>
    <a slot="actions" href={site.donation.page} target="_blank" rel="noopener" data-zeffy="donate-dialog" class="btn btn-primary px-7 text-base">
      Support Sabeel
    </a>
  </PageHero>

  <!-- The demand -->
  <section class="py-14 md:py-16" aria-labelledby="demand-heading">
    <div class="container-page">
      <SectionHeading title="The demand is already here" id="demand-heading" />
      <div class="mt-10 grid items-center gap-8 md:grid-cols-[minmax(0,19rem)_1fr] md:gap-14">
        <p class="rounded-card border border-gold/60 border-t-4 border-t-gold bg-surface p-7 text-center shadow-card">
          <span class="block font-display text-7xl leading-none font-bold text-raspberry">608</span>
          <span class="mt-3 block text-lg font-semibold text-ink">program registrations</span>
          <span class="mt-1 block text-[15px] text-ink-soft">Sept 2025–2026</span>
        </p>
        <div class="max-w-[40rem] space-y-4 text-base leading-[1.8] text-ink-soft md:text-[17px]">
          <p>
            Learners registered for Sabeel’s summer and Ramadan programs, youth workshops, women’s classes, and Qur’an
            study.
          </p>
          <p>
            As demand grows, we need to hire teachers and build a core team, sustain programs and financial aid, and
            take the next step toward a more reliable place for classes, youth programs, study, and community
            gathering.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What gifts make possible -->
  <section class="border-t border-border py-14 md:py-16" aria-labelledby="gift-heading">
    <div class="container-page">
      <SectionHeading title="What your gift helps make possible" id="gift-heading" />
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {
          needs.map((n) => (
            <li class="rounded-card border border-gold/60 border-t-4 border-t-gold bg-surface p-6 sm:p-7">
              <span class="flex size-12 items-center justify-center rounded-full bg-canvas text-gold-text">
                <Icon name={n.icon} class="size-6" />
              </span>
              <h3 class="mt-4 text-xl font-semibold text-ink">{n.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{n.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand title="Give online">
    <p>Give once or monthly to help Sabeel respond to these needs as they grow.</p>
    <p class="mt-3 text-[15px]">
      {site.name} is a not-for-profit Islamic educational institution in Houston. Donations are tax-deductible; our tax
      ID is {site.taxId}. Online donors receive a tax receipt by email.
    </p>
    <p class="mt-3 text-[15px]">
      Know of a suitable space, or interested in discussing a larger gift? Email{' '}
      <a href={`mailto:${site.financeEmail}`} class="font-medium text-raspberry underline decoration-gold underline-offset-4">{site.financeEmail}</a>.
    </p>
    <a slot="actions" href={site.donation.page} target="_blank" rel="noopener" data-zeffy="donate-dialog" class="btn btn-primary px-7 text-base">
      Donate online
    </a>
  </CtaBand>
  <ZeffyDialog id="donate-dialog" title={`Donate to ${site.name}`} label="Donation form" form={site.donation} />
</BaseLayout>
