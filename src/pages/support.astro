---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ZeffyDialog from '../components/ZeffyDialog.astro';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { site } from '../site.config';

// What gifts support, today and ahead.
const supports = [
  { title: 'Programs today', text: 'Teachers, curriculum, and youth programming for the classes running now.' },
  { title: 'Scholarships', text: 'Financial aid, so cost never keeps a student from learning.' },
  { title: 'A permanent home', text: 'A home of Sabeel’s own in Houston, with room to learn, gather, and serve.' },
] as const;
---

<BaseLayout
  title="Support Our Work"
  description="Support Sabeel Institute, a not-for-profit for Islamic learning in Houston. Donations are tax-deductible."
>
  <PageHero
    eyebrow="Support our work"
    title="Give to Sabeel Institute."
    photo="support-hero"
    photoAlt="Sabeel classes in borrowed and rented rooms over the years"
    photoIcon="hand-heart"
  >
    <p>
      For more than 15 years, Sabeel has taught in borrowed and rented rooms. Your gift keeps our classes running today
      and helps us toward a home of our own.
    </p>
    <Fragment slot="actions">
      <a href={site.donation.page} target="_blank" rel="noopener" data-zeffy="donate-dialog" class="btn btn-primary px-6 text-base">Donate online</a>
      <a href="#give" class="btn btn-outline px-6 text-base">Ways to give</a>
    </Fragment>
  </PageHero>

  <!-- What gifts support -->
  <section class="py-14 md:py-16" aria-labelledby="gift-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Your gift" title="What your gift supports." id="gift-heading">
        <p>Gifts are used where they’re needed most.</p>
      </SectionHeading>
      <ul class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          supports.map((d) => (
            <li class="rounded-card border border-gold/60 bg-surface p-6">
              <h3 class="text-xl font-semibold text-ink">{d.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{d.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- How to give -->
  <section id="give" class="scroll-mt-6 border-y border-border bg-sage-mist py-14 md:py-16" aria-labelledby="give-heading">
    <div class="container-page">
      <SectionHeading eyebrow="How to give" title="Give online or with Zelle." id="give-heading" />
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        <article class="flex flex-col rounded-card border border-gold/70 border-t-4 border-t-gold bg-surface p-6 shadow-card sm:p-8">
          <span class="flex size-12 items-center justify-center rounded-full bg-canvas text-gold-text">
            <Icon name="credit-card" class="size-6" />
          </span>
          <h3 class="mt-4 text-2xl font-semibold text-ink">Donate online</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">
            On our secure donation form, choose your amount and how often to give. Your tax receipt arrives by email.
          </p>
          <div class="mt-auto pt-6">
            <a href={site.donation.page} target="_blank" rel="noopener" data-zeffy="donate-dialog" class="btn btn-primary w-full py-4 text-base">
              Donate online
            </a>
            <p class="mt-3 flex items-center justify-center gap-2 text-sm text-ink-soft">
              <Icon name="lock" class="size-4 text-success" /> Secure donation · Tax-deductible
            </p>
          </div>
        </article>
        <article class="flex flex-col rounded-card border border-gold/70 border-t-4 border-t-gold bg-surface p-6 shadow-card sm:p-8">
          <span class="flex size-12 items-center justify-center rounded-full bg-canvas text-gold-text">
            <Icon name="landmark" class="size-6" />
          </span>
          <h3 class="mt-4 text-2xl font-semibold text-ink">Donate with Zelle</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">Send your gift with Zelle from your bank’s app to:</p>
          <p class="mt-2 text-lg font-semibold break-all text-ink">{site.zelle}</p>
          <div class="mt-auto pt-6">
            <button type="button" data-copy={site.zelle} aria-live="polite" hidden class="btn btn-outline w-full py-4 text-base">
              Copy address
            </button>
            <p class="mt-3 text-center text-sm text-ink-soft">Tax-deductible</p>
          </div>
        </article>
      </div>
      <p class="mt-8 text-[15px] leading-relaxed text-ink-soft">
        Sabeel Institute is a not-for-profit in Houston, Texas. Our tax ID is{' '}
        <span class="font-semibold text-ink">{site.taxId}</span>. Questions?{' '}
        <a href={`mailto:${site.email}`} class="font-medium text-raspberry underline decoration-gold underline-offset-4">{site.email}</a>
      </p>
    </div>
  </section>

  <!-- Rukaiya's story -->
  <section class="py-14 md:py-16" aria-labelledby="story-heading">
    <div class="container-page grid items-center gap-10 md:grid-cols-2 md:gap-16">
      <Photo slot="rukaiya" alt="Sr. Rukaiya Ahmed" class="aspect-[4/3] shadow-card" />
      <div>
        <p class="eyebrow">Rukaiya’s story</p>
        <h2 id="story-heading" class="display-md mt-2 sm:text-[2.4rem]">From a summer garden to the board.</h2>
        <Divider class="mt-4" />
        <p class="mt-5 text-[17px] leading-[1.85] text-ink-soft">
          Rukaiya joined Sabeel in high school through our Summer Garden program, then completed the three-year
          Classical Islamic Knowledge program. Today she serves on Sabeel’s board.
        </p>
        <a href="/teachers-and-team/rukaiya-ahmed/" class="link-arrow mt-6">
          Read Rukaiya’s bio <Icon name="arrow-right" class="size-4" />
        </a>
      </div>
    </div>
  </section>

  <ZeffyDialog id="donate-dialog" title={`Donate to ${site.name}`} label="Donation form" form={site.donation} />
</BaseLayout>

<script>
  // Copy buttons appear only where the browser can copy; the text beside them stays selectable.
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    if (!navigator.clipboard) continue;
    button.hidden = false;
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy!);
      button.textContent = 'Copied';
      setTimeout(() => (button.textContent = 'Copy address'), 2000);
    });
  }
</script>
