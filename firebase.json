{
  "hosting": {
    "site": "sabeel-website-test",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/courses{,/}",
        "destination": "/programs/",
        "type": 301
      },
      {
        "source": "/courses/:rest*",
        "destination": "/programs/:rest",
        "type": 301
      },
      {
        "source": "/my-courses/:rest*",
        "destination": "/programs/",
        "type": 301
      },
      {
        "source": "/our-courses{,/**}",
        "destination": "/programs/",
        "type": 301
      },
      {
        "source": "/past-courses{,/**}",
        "destination": "/past-programs/",
        "type": 301
      },
      {
        "source": "/our-team{,/}",
        "destination": "/teachers-and-team/",
        "type": 301
      },
      {
        "source": "/our-team/:rest*",
        "destination": "/teachers-and-team/:rest",
        "type": 301
      },
      {
        "source": "/teachers-and-team/afsha-muhammad{,/}",
        "destination": "/teachers-and-team/afsha-mohammad/",
        "type": 301
      },
      {
        "source": "/teachers-and-team/rukaiya-ahamed{,/}",
        "destination": "/teachers-and-team/rukaiya-ahmed/",
        "type": 301
      },
      {
        "source": "/directors-and-teachers{,/**}",
        "destination": "/teachers-and-team/",
        "type": 301
      },
      {
        "source": "/admin-staff{,/**}",
        "destination": "/teachers-and-team/",
        "type": 301
      },
      {
        "source": "/seminary{,/**}",
        "destination": "/hikam-foundations/",
        "type": 301
      },
      {
        "source": "/donate{,/**}",
        "destination": "/support/",
        "type": 301
      },
      {
        "source": "/donation{,/**}",
        "destination": "/support/",
        "type": 301
      },
      {
        "source": "/our-mission{,/**}",
        "destination": "/about/",
        "type": 301
      },
      {
        "source": "/testimonials{,/**}",
        "destination": "/hikam-foundations/",
        "type": 301
      },
      {
        "source": "/blog{,/**}",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/blog-2{,/**}",
        "destination": "/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/_visual-diff/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
