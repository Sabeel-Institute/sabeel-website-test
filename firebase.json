{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      { "source": "/index.html", "destination": "/", "type": 301 },
      { "source": "/our-mission{,/**}", "destination": "/about/", "type": 301 },
      { "source": "/directors-and-teachers{,/**}", "destination": "/our-team/#teachers", "type": 301 },
      { "source": "/admin-staff{,/**}", "destination": "/our-team/#admin", "type": 301 },
      { "source": "/hikam-foundations{,/**}", "destination": "/seminary/", "type": 301 },
      { "source": "/my-courses{,/**}", "destination": "/courses/", "type": 301 },
      { "source": "/our-courses{,/**}", "destination": "/courses/", "type": 301 },
      { "source": "/donation{,/**}", "destination": "/donate/", "type": 301 },
      { "source": "/blog-2{,/**}", "destination": "/blog/", "type": 301 }
    ],
    "headers": [
      {
        "source": "/_astro/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
